---
// WindowFrame.astro
// Empty image-window placeholder matching the public/ .window-out frame
// (neutral 4:3 box, empty .window-fill, border-on-fill, breath-in fade).
//
// Swap-to-real-image path — pass a real image as the default slot:
//   <WindowFrame><img src="…" alt="…" /></WindowFrame>
// The empty fill, its legibility border, and aria-hidden are all dropped
// automatically, leaving the borderless real image (like curious-summary).
const hasImage = Astro.slots.has('default');
---
{hasImage
  ? <figure class="window-out"><slot /></figure>
  : <figure class="window-out" aria-hidden="true"><div class="window-fill"></div></figure>
}

<style>
.window-out {
  max-width: 450px;
  width: 100%;
  margin: 0 auto 56px;
  position: relative;
  border-radius: var(--oy-radius, 4px);
  overflow: hidden;
  opacity: 0;
  animation: windowBreathIn 2.4s ease 0.4s forwards;
}
.window-out :global(img),
.window-out .window-fill { display: block; width: 100%; }
.window-out :global(img) { height: auto; }
.window-out .window-fill { aspect-ratio: 4 / 3; background: rgba(127,119,110,0.16); border: 1px solid rgba(127,119,110,0.28); }
.window-out::after {
  content: '';
  position: absolute;
  inset: 0;
  pointer-events: none;
  border-radius: var(--oy-radius, 4px);
  box-shadow: inset 0 0 24px 4px rgba(0,0,0,0.18);
}
@keyframes windowBreathIn { from { opacity: 0; } to { opacity: 1; } }
</style>
