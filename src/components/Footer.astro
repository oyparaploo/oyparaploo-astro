---
// Shared site footer — one source of truth for the 8 .astro pages (the 2 layouts +
// 6 standalone). GROUNDS / PRACTICE / CONNECT + copyright. Mode-explicit colors:
// LIGHT is the default (covers light-native classed pages AND the no-ground-class
// light pages); DARK overrides on body.ground-dark:not(.light-mode) (dark-native
// default) and body.dark-mode (any toggle) — so it renders correctly regardless of
// the page's native ground. Content colors are solid hex; atmosphere (footer bg
// overlay, rule, accent gradient) stays rgba per spec.
---
<footer class="site-footer" role="contentinfo">
  <hr class="footer-accent-rule" aria-hidden="true">
  <div class="footer-inner">
    <div class="footer-cols">
      <div class="footer-col"><div class="footer-col-title">Grounds</div><a href="/writing/">Writing</a><a href="/portraits/">Portraits</a><a href="/methodology/">Methodology</a><a href="/good-grounds/">Good Grounds</a><a href="/prayers/">The Prayers</a></div>
      <div class="footer-col"><div class="footer-col-title">Practice</div><a href="/our-practice/">Our Practice</a><a href="/making/">Making</a><a href="/listening-room/">Sound</a><a href="/broadcast/">The Broadcast</a><a href="/wavelength/">Wavelength</a></div>
      <div class="footer-col"><div class="footer-col-title">Connect</div><a href="/archive/">Archive</a><span class="footer-soon">Calendar</span><a href="mailto:info@oyparaploo.com">Contact</a></div>
    </div>
    <hr class="footer-rule" aria-hidden="true">
    <div class="footer-copyright">&copy; 2026 Oyparaploo &middot; Twin Cities, Minnesota</div>
  </div>
</footer>

<style is:global>
/* ── Shared footer — structural (mode-independent) ── */
.footer-accent-rule{display:block;height:2px;border:none;background:linear-gradient(90deg,transparent 0%,rgba(122,90,74,0.35) 8%,rgba(122,90,74,0.55) 15%,rgba(122,90,74,0.28) 24%,rgba(92,58,30,0.45) 34%,rgba(92,58,30,0.65) 44%,rgba(92,58,30,0.28) 54%,rgba(122,90,74,0.50) 63%,rgba(160,128,100,0.40) 74%,rgba(160,128,100,0.28) 83%,rgba(122,90,74,0.30) 90%,transparent 100%);opacity:.6;}
.footer-inner{max-width:1400px;margin:0 auto;padding:56px 40px 44px;font-family:'Inter',sans-serif;}
.footer-cols{display:flex;flex-wrap:wrap;gap:40px 72px;}
.footer-col{min-width:160px;}
.footer-col-title{font-size:17px;font-weight:600;letter-spacing:.12em;text-transform:uppercase;margin-bottom:16px;}
.footer-col a,.footer-col .footer-soon{display:block;font-size:18px;line-height:2;letter-spacing:.01em;text-decoration:none;}
.footer-col a{transition:color .2s;}
.footer-col .footer-soon{cursor:default;}
.footer-rule{height:1px;border:none;margin:36px 0 18px;}
.footer-copyright{font-size:17px;letter-spacing:.02em;}
/* ── LIGHT (default): light-native classed pages + no-ground-class light pages ── */
.site-footer{background:rgba(0,0,0,0.03);}
.footer-col-title{color:#8a8078;}
.footer-col a,.footer-col .footer-soon{color:#4a4038;}
.footer-col a:hover{color:#2a2320;}
.footer-rule{background:rgba(0,0,0,.1);}
.footer-copyright{color:#4a4038;}
/* ── DARK override: dark-native default (ground-dark, no light-mode) + any .dark-mode toggle ── */
body.ground-dark:not(.light-mode) .site-footer,body.dark-mode .site-footer{background:rgba(0,0,0,0.25);}
body.ground-dark:not(.light-mode) .footer-col-title,body.dark-mode .footer-col-title{color:rgba(232,224,214,.5);}
body.ground-dark:not(.light-mode) .footer-col a,body.ground-dark:not(.light-mode) .footer-col .footer-soon,body.dark-mode .footer-col a,body.dark-mode .footer-col .footer-soon{color:#cfc7bd;}
body.ground-dark:not(.light-mode) .footer-col a:hover,body.dark-mode .footer-col a:hover{color:rgba(232,224,214,.95);}
body.ground-dark:not(.light-mode) .footer-rule,body.dark-mode .footer-rule{background:rgba(232,224,214,.12);}
body.ground-dark:not(.light-mode) .footer-copyright,body.dark-mode .footer-copyright{color:#cfc7bd;}
</style>
