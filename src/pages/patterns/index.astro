---
// PATTERN BOOK — gallery index. noindex. Not linked from site nav/menu.
const patterns = [
  { slug: 'breath-display', name: 'Breath Display', desc: 'Ellipsis-paced fragment writing, staggered fade-in, dark ground.' },
  { slug: 'dark-reading', name: 'Dark Reading', desc: 'Reading-variant treatment on dark ground.' },
  { slug: 'plate-sequence', name: 'Plate Sequence', desc: 'New candidate — vertical image/caption sequence, dark ground.' },
  { slug: 'full-bleed', name: 'Full Bleed', desc: 'New candidate — edge-to-edge hero plate with title and caption, dark ground.' },
];
---
<!DOCTYPE html>
<html lang="en" class="size-1">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="robots" content="noindex">
<title>Pattern Book — Paraploo, The Elder</title>
<link href="https://fonts.googleapis.com/css2?family=Lora:wght@400;500;600;700&family=Inter:wght@400;450;500;600;700&display=swap" rel="stylesheet">
<style>
*, *::before, *::after { margin: 0; padding: 0; box-sizing: border-box; }
* { font-style: normal; }
html { font-size: var(--root-size, 17px); scroll-behavior: smooth; }
body { font-family: 'Inter', sans-serif; -webkit-font-smoothing: antialiased; overflow-x: hidden;
  background: linear-gradient(to bottom, #000000 0%, #020203 20%, #060810 40%, #0a0d16 60%, #0d111b 80%, #111521 100%);
  background-attachment: fixed; color: #d0c8bf; min-height: 100vh; }
a { color: inherit; text-decoration: none; }
button { font-family: inherit; border: none; background: none; cursor: pointer; }
html.size-1 { --root-size: 17px; } html.size-2 { --root-size: 18px; } html.size-3 { --root-size: 20px; }

/* ═══ STÄDEL NAV ═══ */
.site-nav { position: sticky; top: 0; z-index: 100; background: rgba(0,0,0,0.92); -webkit-backdrop-filter: blur(12px); backdrop-filter: blur(12px); }
.nav-inner { max-width: 1400px; margin: 0 auto; padding: 0 40px; height: 64px; display: flex; align-items: center; }
.wordmark { font-family: 'Inter', sans-serif; font-weight: 500; font-size: 22px; color: rgba(232,224,214,0.68); letter-spacing: 0.02em; flex-shrink: 0; transition: color 0.2s; }
.wordmark:hover { color: rgba(232,224,214,0.88); }
.nav-links { display: flex; gap: 32px; list-style: none; margin-left: 48px; flex-shrink: 0; }
.nav-links a { font-family: 'Inter', sans-serif; font-size: 20px; font-weight: 400; color: rgba(232,224,214,0.68); transition: color 0.2s; }
.nav-links a:hover { color: rgba(232,224,214,0.88); }
.nav-utils { display: flex; align-items: center; gap: 8px; margin-left: auto; }
.nav-aaa { display: flex; align-items: center; gap: 2px; min-height: 44px; }
.nav-aaa button { min-width: 26px; min-height: 44px; display: flex; align-items: center; justify-content: center; color: rgba(232,224,214,0.5); transition: color 0.2s; }
.nav-aaa button:nth-child(1) { font-size: 13px; }
.nav-aaa button:nth-child(2) { font-size: 16px; }
.nav-aaa button:nth-child(3) { font-size: 19px; }
.nav-aaa button.active, .nav-aaa button:hover { color: rgba(232,224,214,0.88); }
#contrastBtn, #searchBtn { min-width: 44px; min-height: 44px; display: flex; align-items: center; justify-content: center; color: rgba(232,224,214,0.5); transition: color 0.2s; }
#contrastBtn:hover, #searchBtn:hover { color: rgba(232,224,214,0.88); }
.nav-hamburger { display: flex; flex-direction: column; gap: 5px; min-width: 44px; min-height: 44px; align-items: center; justify-content: center; }
.nav-hamburger span { display: block; width: 22px; height: 1.5px; background: rgba(232,224,214,0.5); transition: transform 0.25s, opacity 0.2s; }
.nav-hamburger.open span:nth-child(1) { transform: translateY(6.5px) rotate(45deg); }
.nav-hamburger.open span:nth-child(2) { opacity: 0; }
.nav-hamburger.open span:nth-child(3) { transform: translateY(-6.5px) rotate(-45deg); }
.nav-accent-rule { display: block; height: 2px; border: none; background: linear-gradient(90deg, transparent 0%, rgba(122,90,74,0.35) 8%, rgba(92,58,30,0.65) 44%, rgba(160,128,100,0.40) 74%, transparent 100%); opacity: 0.6; }
@media (max-width: 1100px) { .nav-links { display: none; } }

/* ═══ MENU ═══ */
.menu-overlay { position: fixed; inset: 0; z-index: 200; background: rgba(0,0,0,0.45); opacity: 0; pointer-events: none; transition: opacity 0.6s; }
.menu-overlay.open { opacity: 1; pointer-events: auto; }
.menu-panel { position: fixed; top: 0; right: 0; bottom: 0; z-index: 201; width: 400px; max-width: 90vw; background: #faf6f0; color: #2a2320; font-size: 17px; clip-path: inset(16px 20px calc(100% - 68px) calc(100% - 200px) round 4px); transition: clip-path 0.6s cubic-bezier(0.4,0,0.1,1), opacity 0.2s ease; overflow-y: auto; padding: 24px 32px 40px; pointer-events: none; opacity: 0; }
.menu-panel.open { clip-path: inset(0 0 0 0 round 0); pointer-events: auto; opacity: 1; }
.menu-top { display: flex; align-items: center; justify-content: space-between; margin-bottom: 32px; }
.menu-ghost-wordmark { font-family: 'Inter', sans-serif; font-size: 22px; font-weight: 500; color: #2a2320; opacity: 0.38; }
.menu-close { width: 44px; height: 44px; display: flex; align-items: center; justify-content: center; font-size: 22px; color: #2a2320 !important; }
.menu-nav-primary a { font-family: 'Lora', serif; font-size: 24px; font-weight: 600; color: #2a2320; display: block; padding: 10px 0; }
.menu-rule-tan { height: 2px; border: none; background: #D4A574; margin: 20px 0; }
.menu-rule-sage { height: 2px; border: none; background: #8BA89A; margin: 20px 0; }
.menu-nav-secondary a, .menu-nav-tertiary a { font-family: 'Inter', sans-serif; font-size: 18px; font-weight: 600; color: #2a2320; display: block; padding: 4px 0; }
.menu-address { font-family: 'Inter', sans-serif; font-size: 19px; font-weight: 500; color: #5a4f47; margin-top: 20px; }
.menu-bottom-btns { margin-top: 20px; }
.menu-bottom-btns .menu-btn { font-family: 'Inter', sans-serif; font-size: 16px; font-weight: 500; letter-spacing: 0.06em; text-transform: uppercase; color: #2a2320; border: 1px solid rgba(42,35,32,0.40); padding: 8px 16px; border-radius: 4px; background: transparent; min-height: 44px; }
.menu-bottom-btns .menu-btn:hover { background: transparent; color: #7a5028; border-color: #7a5028; }
@media (max-width: 768px) { .nav-inner { padding: 0 24px; } .menu-panel { width: 100%; max-width: 100%; } }

/* ═══ GALLERY INDEX ═══ */
.pb-wrap { max-width: 1000px; margin: 0 auto; padding: 76px 40px 100px; }
.pb-title { font-family: 'Lora', serif; font-size: clamp(32px, 3.8vw, 44px); font-weight: 600; color: #d0c8bf; margin-bottom: 48px; }
.pb-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 24px; }
.pb-card { display: block; border: 1px solid #3a3430; padding: 28px 28px 24px; transition: border-color 0.3s ease, background 0.3s ease; }
.pb-card:hover { border-color: #5a5048; background: #141210; }
.pb-card-title { font-family: 'Lora', serif; font-size: 1.2941rem; font-weight: 500; color: #ccc5bc; margin-bottom: 13px; }
.pb-card:hover .pb-card-title { color: #e8e0d8; }
.pb-card-desc { font-family: 'Inter', sans-serif; font-size: 1rem; font-weight: 400; color: #b5ada5; line-height: 1.65; }
@media (max-width: 768px) { .pb-wrap { padding: 60px 24px 80px; } .pb-grid { grid-template-columns: 1fr; } }
</style>
</head>
<body>

<nav class="site-nav" aria-label="Site navigation">
<div class="nav-inner">
<a href="/patterns/" class="wordmark">paraploo, the elder</a>
<ul class="nav-links">
<li><a href="#">Writing</a></li>
<li><a href="#">Portraits</a></li>
<li><a href="#">Practice</a></li>
<li><a href="#">Dispatches</a></li>
</ul>
<div class="nav-utils">
<div class="nav-aaa"><button data-size="1" class="active" aria-label="Small text">A</button><button data-size="2" aria-label="Medium text">A</button><button data-size="3" aria-label="Large text">A</button></div>
<button id="contrastBtn" aria-label="Toggle contrast"><svg width="18" height="18" viewBox="0 0 18 18" aria-hidden="true"><circle cx="9" cy="9" r="7.5" fill="none" stroke="currentColor" stroke-width="1.4"/><path d="M9 1.5a7.5 7.5 0 0 1 0 15z" fill="currentColor"/></svg></button>
<button class="nav-hamburger" aria-label="Open menu" aria-expanded="false" id="navHamburger"><span></span><span></span><span></span></button>
</div>
</div>
<div class="nav-accent-rule" aria-hidden="true"></div>
</nav>

<div class="menu-overlay" id="menuOverlay"></div>
<div class="menu-panel" id="menuPanel" role="dialog"><div class="menu-top"><span class="menu-ghost-wordmark">paraploo, the elder</span><button class="menu-close" id="menuCloseBtn">&#10005;</button></div><div class="menu-content"><nav class="menu-nav-primary"><a href="#">Writing</a><a href="#">Making</a><a href="#">Good Grounds</a></nav><hr class="menu-rule-tan"><nav class="menu-nav-secondary"><a href="#">Our Practice</a><a href="#">Music Artists</a><a href="#">Collaborators</a></nav><hr class="menu-rule-sage"><nav class="menu-nav-tertiary"><a href="#">Support</a><a href="#">Archive</a><a href="#">Contact</a></nav><div class="menu-address">Minneapolis ~ Saint Paul</div><div class="menu-bottom-btns"><button class="menu-btn">Subscribe</button></div></div></div>

<main class="pb-wrap">
<h1 class="pb-title">Pattern Book</h1>
<div class="pb-grid">
{patterns.map((p) => (
  <a class="pb-card" href={`/patterns/${p.slug}/`}>
    <div class="pb-card-title">{p.name}</div>
    <div class="pb-card-desc">{p.desc}</div>
  </a>
))}
</div>
</main>

<script>
var sizeStep=1,aaaBtns=document.querySelectorAll('.nav-aaa button');
aaaBtns.forEach(function(b){b.addEventListener('click',function(){sizeStep=parseInt(this.dataset.size);document.documentElement.classList.remove('size-1','size-2','size-3');document.documentElement.classList.add('size-'+sizeStep);aaaBtns.forEach(function(x){x.classList.toggle('active',parseInt(x.dataset.size)===sizeStep)})})});
document.getElementById('contrastBtn').addEventListener('click',function(){document.body.classList.toggle('light-mode')});
var navH=document.getElementById('navHamburger'),menuC=document.getElementById('menuCloseBtn'),menuO=document.getElementById('menuOverlay'),menuP=document.getElementById('menuPanel');
navH.addEventListener('click',function(){menuO.classList.add('open');menuP.classList.add('open');navH.classList.add('open')});
menuC.addEventListener('click',function(){menuO.classList.remove('open');menuP.classList.remove('open');navH.classList.remove('open')});
menuO.addEventListener('click',function(){menuO.classList.remove('open');menuP.classList.remove('open');navH.classList.remove('open')});
document.addEventListener('keydown',function(e){if(e.key==='Escape'){menuO.classList.remove('open');menuP.classList.remove('open');navH.classList.remove('open')}});
</script>
</body>
</html>
