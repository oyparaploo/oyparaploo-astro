---
// Feel-doors entry — the by-feel way in. DARK-NATIVE (matches the Writing room and the
// cluster interiors; chrome grafted VERBATIM from clusters/[slug]/index.astro). Seven
// named doors, warmest -> coldest, each opening onto its five curated pieces. Each piece
// is a card: published title + one harvested door-copy line (VERBATIM), linking to that
// piece's reading page. Doors + picks + lines come from feel-doors.js — the same source
// the per-door interiors (feel/[door].astro) render from, so entry and rooms stay in sync.
// Titles render from each piece's published frontmatter title at build time.
import { getCollection } from 'astro:content';
import { FEEL_DOORS } from '../../../lib/feel-doors.js';

const titles = {};
for (const e of await getCollection('writing')) titles[e.id] = e.data.title;

// DRAFT door descriptions — one quiet sub-line per door, so a visitor knows what's
// inside before tapping. Written here (not in feel-doors.js) by reading each door's five
// pieces + its place on the warmest->coldest run. Placeholders for Reach to approve or
// rewrite; keyed by door name.
const DOOR_DESCRIPTIONS = {
  'Open Door': 'The warmest welcome: trust, small daily miracles, and the sacred hiding in ordinary acts.',
  'Bench': 'Sit a while — stillness, patience, and the quiet mercy of things that wait.',
  'Held Hand': 'Company for the tender hours: leaning together, shared grief, and love that knows what to say.',
  'Deadpan': 'Dry wit, delivered straight-faced — small absurdities and a crooked grin under the gloom.',
  'Witness': 'Bearing witness to the erased and unseen: cages, empty chairs, and stubborn, defiant survival.',
  'Trap': 'The floor giving way — collapse, dread, and a strange calm as it all comes down.',
  'Wander': 'Roving and open-ended: spirals, unnamed things, and questions circling toward what wants to become.',
};

const doors = FEEL_DOORS.map((door) => {
  const desc = DOOR_DESCRIPTIONS[door.name];
  if (!desc) throw new Error(`writing/feel/index.astro: no description for door "${door.name}" — DOOR_DESCRIPTIONS is out of sync with feel-doors.js. Stopping rather than rendering a door with no sub-line.`);
  return {
  name: door.name,
  slug: door.slug,
  desc,
  pieces: door.pieces.map(({ slug, line }) => {
    const title = titles[slug];
    if (!title) throw new Error(`writing/feel/index.astro: no piece for slug "${slug}" in door "${door.name}" — feel-doors.js references a piece that is not in the collection. Stopping rather than guessing.`);
    if (!line || !line.trim()) throw new Error(`writing/feel/index.astro: missing door-copy line for "${slug}" in door "${door.name}" — every card must show its line. Stopping rather than rendering a blank card.`);
    return { slug, title, line };
  }),
  };
});

// PLACEHOLDER copy — Reach names the page. Intro is plain nav copy, not harvested voice.
const PAGE_TITLE = 'Enter by Feel';
const PAGE_INTRO = 'Seven doors, warmest to coldest. Each opens onto five pieces — enter by the feeling you are carrying.';
---
<!DOCTYPE html>
<html lang="en" class="size-1">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{PAGE_TITLE} — Writing — Oyparaploo</title>
<link href="https://fonts.googleapis.com/css2?family=Lora:wght@400;500;600;700&family=Inter:wght@400;450;500;600;700&display=swap" rel="stylesheet">
<style is:global>
/* ═══ RESET & BASE (skeleton-landing-dark, verbatim chrome) ═══ */
*, *::before, *::after { margin: 0; padding: 0; box-sizing: border-box; }
p, h1, h2, h3, h4, li, blockquote { text-wrap: pretty; }
em, i, cite, address, dfn, var { font-style: normal; }
* { font-style: normal; }
html { overflow-x: hidden; scroll-behavior: smooth; font-size: var(--root-size, 17px); -webkit-text-size-adjust: 100%; text-size-adjust: 100%; }
body { font-family: 'Inter', sans-serif; -webkit-font-smoothing: antialiased; overflow-x: hidden; overflow-wrap: break-word; word-break: break-word; transition: background 0.4s ease, color 0.3s ease; }
a { color: inherit; text-decoration: none; }
a, button, [role="button"], select { touch-action: manipulation; -webkit-tap-highlight-color: transparent; }
button { font-family: inherit; border: none; background: none; cursor: pointer; }
ul, ol { list-style: none; }
img { max-width: 100%; height: auto; display: block; }

:root { --oy-tan: #D4A574; --oy-radius: 4px; }

/* font size system */
html.size-1 { --root-size: 17px; } html.size-2 { --root-size: 18px; } html.size-3 { --root-size: 20px; }
.font-size-btn { display: flex; gap: 2px; font-weight: 600; align-items: baseline; }
.font-size-btn .sz { color: rgba(232,224,214,0.68) !important; opacity: 1; transition: opacity 0.25s; line-height: 1; }
.font-size-btn .sz[data-size="1"] { font-size: 22px; } .font-size-btn .sz[data-size="2"] { font-size: 18px; } .font-size-btn .sz[data-size="3"] { font-size: 15px; }

/* Städel nav — dark ground native */
.site-nav { position: sticky; top: 0; z-index: 100; background: rgba(0,0,0,0.92); -webkit-backdrop-filter: blur(12px); backdrop-filter: blur(12px); transition: background 0.3s; }
.nav-inner { max-width: 1400px; margin: 0 auto; padding: 0 40px; height: 64px; display: flex; align-items: center; }
.wordmark { font-family: 'Inter', sans-serif; font-weight: 500; font-size: 22px; color: rgba(232,224,214,0.68); letter-spacing: 0.02em; flex-shrink: 0; transition: color 0.2s; }
.wordmark:hover { color: rgba(232,224,214,0.88); }
.nav-links { display: flex; align-items: center; gap: 32px; list-style: none; padding-left: 0; margin-left: 48px; flex-shrink: 0; }
.nav-links a { font-family: 'Inter', sans-serif; font-size: 21px; font-weight: 500; letter-spacing: 0.02em; color: rgba(232,224,214,0.68); transition: color 0.2s; white-space: nowrap; }
.nav-links a:hover { color: rgba(232,224,214,0.88); }
.nav-utils { display: flex; align-items: center; gap: 12px; margin-left: auto; }
.nav-utils button, .nav-utils a { font-family: 'Inter', sans-serif; color: rgba(232,224,214,0.68); background: none; border: none; cursor: pointer; min-height: 44px; padding: 0 8px; display: flex; align-items: center; justify-content: center; transition: color 0.2s; }
.nav-utils button:hover, .nav-utils a:hover { color: rgba(232,224,214,0.88); }
.nav-utils svg { stroke: currentColor; fill: none; }
.nav-hamburger { display: flex; flex-direction: column; justify-content: center; align-items: center; gap: 5px; min-height: 44px; padding: 0 8px; }
.nav-hamburger span { display: block; width: 22px; height: 1.5px; background: rgba(232,224,214,0.68); transition: transform 0.25s, opacity 0.2s; transform-origin: center; }
.nav-hamburger.open span:nth-child(1) { transform: translateY(6.5px) rotate(45deg); }
.nav-hamburger.open span:nth-child(2) { opacity: 0; transform: scaleX(0); }
.nav-hamburger.open span:nth-child(3) { transform: translateY(-6.5px) rotate(-45deg); }
.nav-accent-rule { display: block; height: 2px; border: none; background: linear-gradient(90deg, transparent 0%, rgba(122,90,74,0.35) 8%, rgba(122,90,74,0.55) 15%, rgba(122,90,74,0.28) 24%, rgba(92,58,30,0.45) 34%, rgba(92,58,30,0.65) 44%, rgba(92,58,30,0.28) 54%, rgba(122,90,74,0.50) 63%, rgba(160,128,100,0.40) 74%, rgba(160,128,100,0.28) 83%, rgba(122,90,74,0.30) 90%, transparent 100%); opacity: 0.6; }

/* menu system (no strips — matches the locked front-door menu) */
.menu-overlay { position: fixed; inset: 0; z-index: 200; background: rgba(0,0,0,0.45); -webkit-backdrop-filter: blur(2px); backdrop-filter: blur(2px); opacity: 0; pointer-events: none; transition: opacity 0.6s; }
.menu-overlay.open { opacity: 1; pointer-events: auto; }
.menu-panel { position: fixed; top: 0; right: 0; bottom: 0; z-index: 201; width: 400px; max-width: 90vw; background: #faf6f0; color: #2a2320; font-size: 17px; clip-path: inset(16px 20px calc(100% - 68px) calc(100% - 200px) round var(--oy-radius)); transition: clip-path 0.6s cubic-bezier(0.4, 0, 0.1, 1), opacity 0.2s ease; overflow-y: auto; padding: 24px 32px 40px; pointer-events: none; opacity: 0; }
.menu-panel.open { clip-path: inset(0 0 0 0 round 0); pointer-events: auto; opacity: 1; }
.menu-top { display: flex; align-items: center; justify-content: space-between; margin-bottom: 32px; }
.menu-ghost-wordmark { font-family: 'Inter', sans-serif; font-size: 22px; font-weight: 500; color: #2a2320; opacity: 0.38; letter-spacing: 0.02em; user-select: none; pointer-events: none; }
.menu-close { width: 44px; height: 44px; display: flex; align-items: center; justify-content: center; font-size: 22px; color: #2a2320 !important; cursor: pointer; transition: opacity 0.2s; flex-shrink: 0; }
.menu-close:hover { opacity: 0.62; }
.menu-nav-primary { margin-bottom: 4px; }
.menu-nav-primary a { font-family: 'Lora', serif; font-size: 24px; font-weight: 600; color: #2a2320; display: block; padding: 10px 0; line-height: 1.2; transition: opacity 0.2s; }
.menu-nav-primary a:hover { opacity: 0.55; }
.menu-rule-tan { height: 2px; border: none; background: var(--oy-tan); margin: 20px 0; }
.menu-rule-sage { height: 2px; border: none; background: #8BA89A; margin: 20px 0; }
.menu-nav-secondary { margin-bottom: 4px; }
.menu-nav-secondary a { font-family: 'Inter', sans-serif; font-size: 18px; font-weight: 600; color: #2a2320; display: block; padding: 4px 0; transition: opacity 0.2s; }
.menu-nav-secondary a:hover { opacity: 0.55; }
.menu-nav-secondary a[aria-disabled="true"] { opacity: 0.4; pointer-events: none; }
.menu-nav-tertiary { display: block; margin-bottom: 4px; }
.menu-nav-tertiary a { font-family: 'Inter', sans-serif; font-size: 18px; font-weight: 600; color: #2a2320; display: block; padding: 4px 0; transition: opacity 0.2s; }
.menu-nav-tertiary a:hover { opacity: 0.55; }
.menu-nav-tertiary a[aria-disabled="true"] { opacity: 0.4; pointer-events: none; }
.menu-address { font-family: 'Inter', sans-serif; font-size: 19px; font-weight: 500; color: #5a4f47; margin-top: 20px; line-height: 1.6; }
.menu-bottom-btns { display: flex; gap: 8px; margin-top: 20px; }
.menu-bottom-btns .menu-btn { font-family: 'Inter', sans-serif; font-size: 16px; font-weight: 500; letter-spacing: 0.06em; text-transform: uppercase; color: #2a2320; border: 1px solid rgba(42,35,32,0.40); padding: 8px 16px; border-radius: var(--oy-radius); background: transparent; cursor: pointer; transition: background 0.2s, color 0.2s, border-color 0.2s; min-height: 44px; }
.menu-bottom-btns .menu-btn:hover { background: #2a2320; color: #faf8f5; border-color: #2a2320; }

/* scroll reveal */
.reveal { opacity: 0; transition: opacity 1s ease; }
.reveal.visible { opacity: 1; }

/* shared responsive */
@media (max-width: 1100px) { .nav-links { display: none; } }
@media (max-width: 768px) { .nav-inner { padding: 0 24px; } .menu-panel { width: 100%; max-width: 100%; } .reveal { transition: opacity 0.6s ease; } }
@media (max-width: 480px) { .nav-inner { padding: 0 24px; } }
.bottom-safe { padding-bottom: env(safe-area-inset-bottom, 0px); }

/* ═══ GROUND — dark native (light-mode toggle overrides below) ═══ */
body { background: linear-gradient(to bottom, #000000 0%, #000000 5%, #020203 12%, #040507 20%, #060810 30%, #080a13 40%, #0a0d16 50%, #0b0f18 60%, #0d111b 70%, #0e121d 80%, #10141f 90%, #111521 100%); background-attachment: fixed; min-height: 100vh; color: #b5ada5; }
body.light-mode { background: #ffffff; background-image: linear-gradient(to bottom, #ffffff 0px, #ffffff 300px, #fdfcfb 700px, #f9f7f4 100%); background-attachment: scroll; color: #4a4038; }
body.light-mode .site-nav { background: rgba(255,255,255,0.97); }
body.light-mode .wordmark { color: #333; } body.light-mode .wordmark:hover { color: #5c3a1e; }
body.light-mode .nav-links a { color: #333; } body.light-mode .nav-links a:hover { color: #5c3a1e; }
body.light-mode .nav-utils button, body.light-mode .nav-utils a { color: #000; }
body.light-mode .nav-utils button:hover, body.light-mode .nav-utils a:hover { color: #5c3a1e; }
body.light-mode .nav-hamburger span { background: #333; }
body.light-mode .font-size-btn .sz { color: #000 !important; }
body.light-mode .nav-accent-rule { opacity: 1; }

/* ═══════════════════════════════════════════════════════════
   FEEL-DOORS ENTRY — content (proven dark solid-hex ladder;
   header type from .cli-*; Card Anatomy .pc-* from proven-values,
   grafted from the cluster interior). Door-section heading .fd-door-name
   is the one new element — no section-subheading exists in the dark
   chrome to reuse; styled on the proven Lora ladder, solid hex.
   All content solid hex; rgba only in inherited chrome / atmosphere.
   ═══════════════════════════════════════════════════════════ */
.cli-container { max-width: 1200px; margin: 0 auto; padding: 0 40px; }

.cli-hero { padding: 72px 0 24px; }
.cli-breadcrumb { display: inline-flex; align-items: center; gap: 6px; font-family: 'Inter', sans-serif; font-size: 1rem; font-weight: 425; color: #a09888; margin-bottom: 28px; transition: color 0.2s; }
.cli-breadcrumb:hover { color: #d0c8bf; }
.cli-breadcrumb svg { stroke: currentColor; fill: none; }
.cli-title { font-family: 'Lora', serif; font-size: clamp(1.8824rem, 3.4vw, 2.5882rem); font-weight: 600; color: #d0c8bf; line-height: 1.2; letter-spacing: -0.01em; margin-bottom: 20px; }
.cli-intro { font-family: 'Inter', sans-serif; font-size: 1.0588rem; font-weight: 400; color: #b5ada5; line-height: 1.78; max-width: 680px; }

/* Doors present as a short accordion list: land on the 7 doors only (name + count),
   tap a door to reveal its 5 cards beneath it. Single-open — opening one closes the
   rest, so no state ever stacks all 35. Door is a real <button>; panels use the native
   `hidden` attr so zero cards show on arrival. Solid hex; type from the proven Lora ladder. */
.fd-doors { margin-top: 44px; }
.fd-door { border-top: 1px solid #3a3430; }
.fd-door:last-of-type { border-bottom: 1px solid #3a3430; }
.fd-door-heading { margin: 0; font-weight: inherit; }
.fd-door-toggle { display: flex; align-items: center; justify-content: space-between; gap: 20px; width: 100%; min-height: 44px; padding: 20px 4px; background: none; border: none; cursor: pointer; text-align: left; }
.fd-door-label { display: flex; flex-direction: column; gap: 7px; }
.fd-door-name { font-family: 'Lora', serif; font-size: clamp(1.2353rem, 2.2vw, 1.5294rem); font-weight: 600; color: #d0c8bf; letter-spacing: -0.01em; line-height: 1.3; transition: color 0.2s ease; }
.fd-door-desc { font-family: 'Inter', sans-serif; font-size: 1rem; font-weight: 400; color: #a09888; line-height: 1.5; letter-spacing: 0.01em; text-wrap: pretty; }
.fd-door-chev { flex-shrink: 0; width: 9px; height: 9px; border-right: 2px solid #a09888; border-bottom: 2px solid #a09888; transform: rotate(45deg); transition: transform 0.25s ease, border-color 0.2s ease; }
.fd-door-toggle:hover .fd-door-name { color: #e8e0d8; }
.fd-door-toggle:hover .fd-door-chev { border-color: #d0c8bf; }
.fd-door-toggle[aria-expanded="true"] .fd-door-chev { transform: rotate(225deg); }
.fd-panel { padding: 4px 0 32px; }
.fd-panel[hidden] { display: none; }

.cli-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px; }
.pc-card { display: block; border: 1px solid #3a3430; padding: 28px 28px 24px; transition: border-color 0.3s ease, background 0.3s ease; }
.pc-card:hover { border-color: #5a5048; background: #141210; }
.pc-title { font-family: 'Lora', serif; font-size: 1.2941rem; font-weight: 500; color: #ccc5bc; line-height: 1.3; letter-spacing: -0.01em; margin-bottom: 13px; transition: color 0.2s ease; }
.pc-card:hover .pc-title { color: #e8e0d8; }
.pc-excerpt { font-family: 'Inter', sans-serif; font-size: 1rem; font-weight: 400; color: #b5ada5; line-height: 1.65; text-wrap: pretty; }

/* light-mode content overrides (solid hex light tiers) */
body.light-mode .cli-breadcrumb { color: #5a4f47; } body.light-mode .cli-breadcrumb:hover { color: #2a2320; }
body.light-mode .cli-title { color: #2a2320; }
body.light-mode .cli-intro { color: #4a4038; }
body.light-mode .fd-door { border-top-color: #c0b8b0; }
body.light-mode .fd-door:last-of-type { border-bottom-color: #c0b8b0; }
body.light-mode .fd-door-name { color: #2a2320; }
body.light-mode .fd-door-toggle:hover .fd-door-name { color: #000000; }
body.light-mode .fd-door-desc { color: #5a4f47; }
body.light-mode .fd-door-chev { border-right-color: #5a4f47; border-bottom-color: #5a4f47; }
body.light-mode .fd-door-toggle:hover .fd-door-chev { border-right-color: #2a2320; border-bottom-color: #2a2320; }
body.light-mode .pc-card { border-color: #b8a088; }
body.light-mode .pc-card:hover { border-color: #8a6e50; background: #faf7f3; }
body.light-mode .pc-title { color: #2a2320; }
body.light-mode .pc-card:hover .pc-title { color: #000000; }
body.light-mode .pc-excerpt { color: #4a4038; }

@media (max-width: 1024px) { .cli-grid { grid-template-columns: repeat(2, 1fr); } }
@media (max-width: 768px) { .cli-container { padding: 0 24px; } .cli-grid { grid-template-columns: 1fr; } .cli-hero { padding: 48px 0 20px; } .fd-door { margin-top: 44px; } }
@media (max-width: 480px) { .cli-container { padding: 0 24px; } }

/* ═══ SEARCH OVERLAY (lazy MiniSearch) — nav infrastructure, both grounds ═══ */
.oy-search { position: fixed; inset: 0; z-index: 300; display: flex; justify-content: center; padding: 96px 24px 32px; overflow-y: auto; opacity: 0; pointer-events: none; transition: opacity 0.4s ease; -webkit-backdrop-filter: blur(14px); backdrop-filter: blur(14px); }
.oy-search.open { opacity: 1; pointer-events: auto; }
.oy-search-inner { width: 100%; max-width: 680px; }
.oy-search-close { position: absolute; top: 24px; right: 24px; width: 44px; height: 44px; display: flex; align-items: center; justify-content: center; font-family: 'Inter', sans-serif; font-size: 24px; line-height: 1; background: none; border: none; cursor: pointer; }
.oy-search-input { width: 100%; background: none; border: none; border-bottom: 1px solid; font-family: 'Lora', serif; font-size: clamp(1.7059rem, 3.2vw, 2.0588rem); font-weight: 400; letter-spacing: -0.01em; padding: 0 0 16px; margin-bottom: 24px; outline: none; }
.oy-search-status { font-family: 'Inter', sans-serif; font-size: 1rem; font-weight: 400; letter-spacing: 0.02em; margin-bottom: 20px; }
.oy-search-results { list-style: none; margin: 0; padding: 0; }
.oy-search-item { border-top: 1px solid; }
.oy-search-link { display: block; padding: 18px 0; text-decoration: none; transition: background 0.2s ease; }
.oy-search-title { display: block; font-family: 'Lora', serif; font-size: 1.2353rem; font-weight: 600; line-height: 1.3; letter-spacing: -0.01em; margin-bottom: 6px; transition: color 0.2s ease; }
.oy-search-meta { display: block; font-family: 'Inter', sans-serif; font-size: 1rem; font-weight: 500; letter-spacing: 0.04em; margin-bottom: 8px; }
.oy-search-excerpt { display: block; font-family: 'Inter', sans-serif; font-size: 1rem; font-weight: 400; line-height: 1.6; text-wrap: pretty; }
@media (max-width: 480px) { .oy-search { padding: 80px 24px 24px; } .oy-search-close { top: 16px; right: 16px; } }
body.ground-light .oy-search, body.ground-dark.light-mode .oy-search { background: rgba(255,255,255,0.97); }
body.ground-light .oy-search-close, body.ground-dark.light-mode .oy-search-close { color: #2a2320; }
body.ground-light .oy-search-input, body.ground-dark.light-mode .oy-search-input { color: #2a2320; border-bottom-color: #b8a088; }
body.ground-light .oy-search-input::placeholder, body.ground-dark.light-mode .oy-search-input::placeholder { color: #5a4f47; }
body.ground-light .oy-search-status, body.ground-dark.light-mode .oy-search-status { color: #5a4f47; }
body.ground-light .oy-search-item, body.ground-dark.light-mode .oy-search-item { border-top-color: #c0b8b0; }
body.ground-light .oy-search-link:hover, body.ground-dark.light-mode .oy-search-link:hover { background: #faf7f3; }
body.ground-light .oy-search-title, body.ground-dark.light-mode .oy-search-title { color: #2a2320; }
body.ground-light .oy-search-link:hover .oy-search-title, body.ground-dark.light-mode .oy-search-link:hover .oy-search-title { color: #000000; }
body.ground-light .oy-search-meta, body.ground-dark.light-mode .oy-search-meta { color: #5a4f47; }
body.ground-light .oy-search-excerpt, body.ground-dark.light-mode .oy-search-excerpt { color: #4a4038; }
body.ground-dark .oy-search, body.ground-light.dark-mode .oy-search { background: rgba(8,9,13,0.95); }
body.ground-dark .oy-search-close, body.ground-light.dark-mode .oy-search-close { color: #d0c8bf; }
body.ground-dark .oy-search-input, body.ground-light.dark-mode .oy-search-input { color: #d0c8bf; border-bottom-color: #5a5048; }
body.ground-dark .oy-search-input::placeholder, body.ground-light.dark-mode .oy-search-input::placeholder { color: #a09888; }
body.ground-dark .oy-search-status, body.ground-light.dark-mode .oy-search-status { color: #a09888; }
body.ground-dark .oy-search-item, body.ground-light.dark-mode .oy-search-item { border-top-color: #3a3430; }
body.ground-dark .oy-search-link:hover, body.ground-light.dark-mode .oy-search-link:hover { background: #141210; }
body.ground-dark .oy-search-title, body.ground-light.dark-mode .oy-search-title { color: #d0c8bf; }
body.ground-dark .oy-search-link:hover .oy-search-title, body.ground-light.dark-mode .oy-search-link:hover .oy-search-title { color: #e8e0d8; }
body.ground-dark .oy-search-meta, body.ground-light.dark-mode .oy-search-meta { color: #a09888; }
body.ground-dark .oy-search-excerpt, body.ground-light.dark-mode .oy-search-excerpt { color: #b5ada5; }
</style>
</head>
