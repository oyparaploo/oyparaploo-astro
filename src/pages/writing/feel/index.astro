  <div class="nav-inner">
    <a href="/" class="wordmark">oyparaploo</a>
    <ul class="nav-links">
      <li><a href="/writing/" class="active">Writing</a></li>
      
      <li><a href="/our-practice/">Practice</a></li>
      <li><a href="/dispatches/">Dispatches</a></li>
    </ul>
    <div class="nav-utils">
      <button id="fontSizeBtn" class="font-size-btn" aria-label="Adjust font size">
