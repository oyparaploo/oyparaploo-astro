body.ground-dark .oy-search-meta, body.ground-light.dark-mode .oy-search-meta { color: #a09888; }
body.ground-dark .oy-search-excerpt, body.ground-light.dark-mode .oy-search-excerpt { color: #b5ada5; }
</style>
</head>
