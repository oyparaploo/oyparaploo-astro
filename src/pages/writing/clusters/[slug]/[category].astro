/* ═══════════════════════════════════════════════════════════
   PAGE-SPECIFIC CSS — LANDING PAGE / LIGHT GROUND
   ═══════════════════════════════════════════════════════════ */

body {
  background: #ffffff;
  background-image: linear-gradient(to bottom,
    #ffffff 0px, #ffffff 300px,
    #fdfcfb 700px, #f9f7f4 100%);
  color: #2a2320;
}

.landing-container {
  max-width: 1200px;
  margin: 0 auto;
  padding: 0 40px;
}

/* ── Hero ── */
.landing-hero {
  padding: 80px 0 64px;
  border-bottom: 1px solid rgba(42,35,32,0.28);
}
.landing-eyebrow {
  font-family: 'Inter', sans-serif;
  font-size: 1rem; font-weight: 600;
  color: #5a4f47; letter-spacing: 0.06em;
  text-transform: uppercase; margin-bottom: 20px;
}
.landing-title {
  font-family: 'Lora', serif;
  font-size: clamp(1.882rem, 4vw, 3.059rem);
  font-weight: 600; color: #2a2320;
  letter-spacing: -0.02em; line-height: 1.15;
  max-width: 700px; margin-bottom: 24px;
}
.landing-description {
  font-family: 'Inter', sans-serif;
  font-size: 1rem; font-weight: 400;
  color: #5a4f47; line-height: 1.7;
  max-width: 580px;
}

/* ── Section ── */
.landing-section {
  padding: 56px 0;
  border-bottom: 1px solid rgba(42,35,32,0.28);
}
.landing-section:last-of-type { border-bottom: none; }

.section-header { margin-bottom: 36px; }
.section-title {
  font-family: 'Lora', serif;
  font-size: clamp(1.353rem, 2.8vw, 1.706rem);
  font-weight: 500; color: #2a2320;
  margin-bottom: 8px;
}
.section-desc {
  font-family: 'Inter', sans-serif;
  font-size: 1rem; font-weight: 400;
  color: #5a4f47; line-height: 1.6;
}

/* ── Card grid ── */
.card-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 24px;
}
.landing-card {
  border: 1px solid rgba(42,35,32,0.32);
  padding: 28px 24px;
  border-radius: var(--oy-radius);
  transition: border-color 0.2s, background 0.2s;
  cursor: pointer;
}
.landing-card:hover {
  border-color: rgba(42,35,32,0.55);
  background: rgba(42,35,32,0.02);
}
.card-label {
  font-family: 'Inter', sans-serif;
  font-size: 1rem; font-weight: 600;
  color: #5a4f47; letter-spacing: 0.04em;
  text-transform: uppercase; margin-bottom: 10px;
}
.card-title {
  font-family: 'Lora', serif;
  font-size: clamp(1.059rem, 1.8vw, 1.353rem);
  font-weight: 500; color: #2a2320;
  line-height: 1.3; margin-bottom: 10px;
}
.card-excerpt {
  font-family: 'Inter', sans-serif;
  font-size: 1rem; font-weight: 400;
  color: #5a4f47; line-height: 1.6;
}

/* ── Dark mode: landing page content ── */
body.dark-mode {
  background: linear-gradient(to bottom,
    #000000 0%, #000000 5%, #020203 12%, #040507 20%,
    #060810 30%, #080a13 40%, #0a0d16 50%, #0b0f18 60%,
    #0d111b 70%, #0e121d 80%, #10141f 90%, #111521 100%);
  background-attachment: fixed;
  min-height: 100vh;
  color: rgba(232,224,214,0.88);
}
body.dark-mode .landing-eyebrow { color: rgba(232,224,214,0.62); }
body.dark-mode .landing-title { color: rgba(232,224,214,0.88); }
body.dark-mode .landing-description { color: rgba(232,224,214,0.65); }
body.dark-mode .landing-hero { border-bottom-color: rgba(232,224,214,0.28); }
body.dark-mode .landing-section { border-bottom-color: rgba(232,224,214,0.28); }
body.dark-mode .section-title { color: rgba(232,224,214,0.80); }
body.dark-mode .section-desc { color: rgba(232,224,214,0.62); }
body.dark-mode .landing-card { border-color: rgba(232,224,214,0.32); }
body.dark-mode .landing-card:hover { border-color: rgba(232,224,214,0.55); background: rgba(232,224,214,0.03); }
body.dark-mode .card-label { color: rgba(232,224,214,0.62); }
body.dark-mode .card-title { color: rgba(232,224,214,0.78); }
body.dark-mode .card-excerpt { color: rgba(232,224,214,0.65); }

/* ── Responsive: landing ── */
@media (max-width: 1024px) {
  .card-grid { grid-template-columns: repeat(2, 1fr); }
}
@media (max-width: 768px) {
  .landing-container { padding: 0 24px; }
  .landing-hero { padding: 48px 0 40px; }
  .card-grid { grid-template-columns: 1fr; }
}
@media (max-width: 480px) {
  .landing-container { padding: 0 24px; }
}



/* ───────────────────────────────────────────────────────────────────
   DOORWAY + HEADER — values lifted verbatim from proven-values.md
   (Page Header, Section Structure, Card Anatomy). Card/grid classes are
   namespaced .cl-* so they never collide with the skeleton's leftover
   .card-* / .card-grid / .section-title content rules above; the skeleton
   chrome CSS is untouched. Dark-mode uses the page's body.dark-mode convention.
   ─────────────────────────────────────────────────────────────────── */
.page-header { max-width: 1200px; margin: 0 auto; padding: 72px 40px 0; }
.page-title { font-family: 'Lora', serif; font-size: clamp(1.8824rem, 3vw, 2.3529rem); font-weight: 600; color: #3a3028; letter-spacing: -0.01em; line-height: 1.25; margin-bottom: 28px; }
.page-intro { max-width: 680px; font-family: 'Inter', sans-serif; font-size: 1.0588rem; font-weight: 400; color: #3a3028; line-height: 1.78; text-wrap: pretty; }
