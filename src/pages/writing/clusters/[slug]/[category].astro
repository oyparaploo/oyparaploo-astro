.cl-name { font-family: 'Lora', serif; font-size: 1.2353rem; font-weight: 600; color: #2a2320; line-height: 1.3; margin-bottom: 12px; letter-spacing: -0.01em; }
.cl-intro { font-family: 'Inter', sans-serif; font-size: 1rem; font-weight: 400; color: #4a4038; line-height: 1.65; text-wrap: pretty; }
body.dark-mode .cl-card { border-color: #3a3430; }
body.dark-mode .cl-card:hover { border-color: #5a5048; background: #141210; }
body.dark-mode .cl-count { color: #a09888; }
body.dark-mode .cl-name { color: #ccc5bc; }
body.dark-mode .cl-intro { color: #b5ada5; }

/* ───────────────────────────────────────────────────────────────────
   CLUSTER INTERIOR — category groups + piece lists.
   Palette and type lifted from the doorway/header rules above; namespaced
   .cl-* so they never collide with the skeleton's leftover content rules.
   ─────────────────────────────────────────────────────────────────── */
.cl-back { display: inline-block; margin-bottom: 24px; font-family: 'Inter', sans-serif; font-size: 1rem; font-weight: 500; color: #5a4f47; letter-spacing: 0.05em; text-transform: uppercase; transition: color 0.2s; }
.cl-back:hover { color: #5c3a1e; text-decoration: underline; }
.cl-cat-section { max-width: 1200px; margin: 0 auto; padding: 48px 40px 0; }
.cl-cat-section:last-of-type { padding-bottom: 8px; }
.cl-cat-title { font-family: 'Lora', serif; font-size: clamp(1.2353rem, 2.2vw, 1.5294rem); font-weight: 600; color: #2a2320; letter-spacing: -0.01em; line-height: 1.3; margin-bottom: 20px; padding-bottom: 14px; border-bottom: 1px solid rgba(42,35,32,0.28); }
.cl-piece { border-bottom: 1px solid rgba(42,35,32,0.12); }
.cl-piece:last-child { border-bottom: none; }
.cl-piece-link { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 8px 24px; padding: 16px 0; }
