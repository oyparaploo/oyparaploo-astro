---
import Footer from '../../../../components/Footer.astro';
// Category interior — one page per cluster x category (the level below
// /writing/clusters/<slug>/, reached from a cluster doorway in a later step).
// Chrome (Stadel nav, cream menu, AAA + contrast toggles, fade reveal, four
// breakpoints), palette, and the entire <style> are carried VERBATIM from the
// sibling clusters/[slug]/index.astro so this page matches its siblings exactly;
// the no-truncate nav rule (.nav-links flex-shrink:0, hide at 1100px) is preserved.
// slugify is imported from src/lib/slug.js — the single shared source — so doorway
// hrefs and generated paths cannot drift. Pieces newest-first via the same dateKey
// parser, ties by title (identical to the cluster page). No category intros
// (categories have none — intended).
import { getCollection } from 'astro:content';
import recoveredDates from '../../../../data/recovered-dates.json';
import { slugify } from '../../../../lib/slug.js';

export async function getStaticPaths() {
  // frontmatter `date:` is stripped by the Zod schema — read it back from the raw file
  const raws = import.meta.glob('../../../../content/writing/*.md', { query: '?raw', import: 'default', eager: true });
  const dateMap = {};
  for (const k in raws) {
    const slug = k.split('/').pop().replace(/\.md$/, '');
    const m = raws[k].match(/^date:\s*"?(.*?)"?\s*$/m);
    if (m) dateMap[slug] = m[1];
  }

  // Same date parser the cluster/interior pages use for newest-first sort.
  const MONTHS = { january:1, february:2, march:3, april:4, may:5, june:6, july:7, august:8, september:9, october:10, november:11, december:12 };
  function dateKey(s) {
    if (!s) return null;
    const t = String(s).trim();
    let m;
    if ((m = t.match(/^(\d{2})\.(\d{2})\.(\d{4})$/))) return +m[3] * 10000 + +m[2] * 100 + +m[1];   // DD.MM.YYYY
    if ((m = t.match(/^(\d{4})-(\d{2})-(\d{2})$/))) return +m[1] * 10000 + +m[2] * 100 + +m[3];   // ISO YYYY-MM-DD
    if ((m = t.match(/^(\d{4})-(\d{2})$/)))          return +m[1] * 10000 + +m[2] * 100 + 1;      // partial ISO YYYY-MM
    if ((m = t.match(/^(\d{4})$/)))                  return +m[1] * 10000 + 101;                  // year only
    if ((m = t.match(/^([A-Za-z]+)\s+(\d{1,2}),\s*(\d{4})$/))) {                                  // Month D, YYYY
      const mo = MONTHS[m[1].toLowerCase()];
      if (mo) return +m[3] * 10000 + mo * 100 + +m[2];
    }
    if ((m = t.match(/^([A-Za-z]+)\s+(\d{4})$/))) {                                               // Month YYYY
      const mo = MONTHS[m[1].toLowerCase()];
      if (mo) return +m[2] * 10000 + mo * 100 + 1;
    }
    return null;
  }

  const pieces = (await getCollection('writing')).filter((e) => !['and-fluid-mosaic'].includes(e.id));
  const byCluster = {};
  for (const p of pieces) {
    const c = p.data.cluster || '(uncategorized)';
    (byCluster[c] ||= []).push(p);
  }

  const paths = [];
  for (const [clusterName, items] of Object.entries(byCluster)) {
    const byCat = {};
    for (const p of items) {
      const cat = p.data.category || '(uncategorized)';
      (byCat[cat] ||= []).push({ id: p.id, title: p.data.title, date: recoveredDates[p.id] || dateMap[p.id] || '' });
    }
    const cs = slugify(clusterName);
    for (const [categoryName, list] of Object.entries(byCat)) {
      // newest first; unparseable dates sort last, ties broken by title — same as the cluster page
      const sorted = list.slice().sort((a, b) => {
        const ka = dateKey(a.date), kb = dateKey(b.date);
        return (kb == null ? -Infinity : kb) - (ka == null ? -Infinity : ka) || a.title.localeCompare(b.title);
      });
      paths.push({
        params: { slug: cs, category: slugify(categoryName) },
        props: { clusterName, clusterSlug: cs, categoryName, pieces: sorted },
      });
    }
  }
  return paths;
}

const { clusterName, clusterSlug, categoryName, pieces } = Astro.props;

const navmenu = `<!-- ═══ STÄDEL NAV ═══ -->
<nav class="site-nav" aria-label="Site navigation">
  <div class="nav-inner">
    <a href="/" class="wordmark">oyparaploo</a>
    <ul class="nav-links">
      <li><a href="/writing/" class="active">Writing</a></li>
      
      <li><a href="/our-practice/">Practice</a></li>
      <li><a href="/dispatches/">Dispatches</a></li>
    </ul>
    <div class="nav-utils">
      <button id="fontSizeBtn" class="font-size-btn" aria-label="Adjust font size">
        <span class="sz active" data-size="1">A</span><span class="sz" data-size="2">A</span><span class="sz" data-size="3">A</span>
      </button>
      <button id="contrastBtn" aria-label="Toggle contrast">
        <svg class="nav-icon" viewBox="0 0 24 24" aria-hidden="true">
          <circle cx="12" cy="12" r="8"/><path d="M12 4 A8 8 0 0 1 12 20 Z" fill="currentColor" stroke="none"/>
        </svg>
      </button>
      <a href="#" id="searchBtn" aria-label="Search">
        <svg width="22" height="22" viewBox="0 0 24 24" stroke-width="2" aria-hidden="true">
          <circle cx="10" cy="10" r="7"/><path d="M15 15l5 5"/>
        </svg>
      </a>
      <button class="nav-hamburger" aria-label="Open menu" aria-expanded="false" id="navHamburger">
        <span></span><span></span><span></span>
      </button>
    </div>
  </div>
  <div class="nav-accent-rule" aria-hidden="true"></div>
</nav>

<!-- ═══ MENU ═══ -->
<div class="menu-overlay" id="menuOverlay" aria-hidden="true"></div>

<div class="menu-panel" id="menuPanel" aria-hidden="true" role="dialog" aria-label="Site menu">
  <div class="menu-top">
    <span class="menu-ghost-wordmark" aria-hidden="true">oyparaploo</span>
    <button class="menu-close" id="menuCloseBtn" aria-label="Close menu">&#10005;</button>
  </div>
  <div class="menu-content">
    <nav class="menu-nav-primary" aria-label="Primary menu">
      <a href="/writing/">Writing</a>
      <a href="/making/">Making</a>
      <a href="/good-grounds/">Good Grounds</a>
    </nav>
    <hr class="menu-rule-tan" aria-hidden="true">
    <nav class="menu-nav-secondary" aria-label="Secondary menu">
      <a href="/our-practice/">Our Practice</a>
      <a aria-disabled="true">Music Artists</a>
      <a aria-disabled="true">Collaborators</a>
      <a href="/methodology/">Methodology</a>
    </nav>
    <hr class="menu-rule-sage" aria-hidden="true">
    <nav class="menu-nav-tertiary" aria-label="Tertiary menu">
      <a href="/support/">Support</a>
      <a href="/archive/">Archive</a>
      <a aria-disabled="true">Calendar</a>
      <a href="mailto:info@oyparaploo.com">Contact</a>
    </nav>
    <div class="menu-address">Minneapolis ~ Saint Paul</div>
    <div class="menu-bottom-btns">
      <button class="menu-btn">Subscribe</button>
    </div>
  </div>
</div>`;
---
<!DOCTYPE html>
<html lang="en" class="size-1">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<link rel="manifest" href="/manifest.webmanifest">
<meta name="theme-color" content="#000000">
<link rel="apple-touch-icon" href="/icons/icon-192.png">
<script src="/sw-register.js" defer></script>
<title>{categoryName} — {clusterName} — Writing — Oyparaploo</title>
<link href="https://fonts.googleapis.com/css2?family=Lora:wght@400;500;600;700&family=Inter:wght@400;450;500;600;700&display=swap" rel="stylesheet">
<style is:global>

/* ═══════════════════════════════════════════════════════════
   OYPARAPLOO SKELETON — VARIANT 3
   Landing Page · Light Ground Native
   Toggle: dark-mode (◐ → ◑)
   Strips: yes (desktop accordion + mobile cards)
   Source: oyparaploo-skeleton.html + the-spec.md
   ═══════════════════════════════════════════════════════════ */


/* ═══ I. RESET & BASE ═══ */
*, *::before, *::after { margin: 0; padding: 0; box-sizing: border-box; }
p, h1, h2, h3, h4, li, blockquote { text-wrap: pretty; }
em, i, cite, address, dfn, var { font-style: normal; }
* { font-style: normal; }

html {
  overflow-x: hidden;
  scroll-behavior: smooth;
  font-size: var(--root-size, 17px);
  -webkit-text-size-adjust: 100%;
  text-size-adjust: 100%;
}

body {
  font-family: 'Inter', sans-serif;
  -webkit-font-smoothing: antialiased;
  overflow-x: hidden;
  overflow-wrap: break-word;
  word-break: break-word;
  transition: background 0.4s ease, color 0.3s ease;
}

a { color: inherit; text-decoration: none; }
a, button, [role="button"], select {
  touch-action: manipulation;
  -webkit-tap-highlight-color: transparent;
}
button { font-family: inherit; border: none; background: none; cursor: pointer; }
ul, ol { list-style: none; }
img { max-width: 100%; height: auto; display: block; }


/* ═══ II. DESIGN TOKENS ═══ */
:root {
  --oy-sand: #D4C4A8;
  --oy-tan:  #D4A574;
  --oy-radius: 4px;
}


/* ═══ III. FONT SIZE SYSTEM ═══ */
html.size-1 { --root-size: 17px; }
html.size-2 { --root-size: 18px; }
html.size-3 { --root-size: 20px; }

/* Light-ground: AAA indicators are black */
.font-size-btn { display: flex; gap: 2px; font-weight: 600; align-items: baseline; }
.font-size-btn .sz {
  color: #000 !important;
  opacity: 1;
  transition: opacity 0.25s;
  line-height: 1;
}
.font-size-btn .sz.active { opacity: 1; }
.font-size-btn .sz[data-size="1"] { font-size: 22px; }
.font-size-btn .sz[data-size="2"] { font-size: 18px; }
.font-size-btn .sz[data-size="3"] { font-size: 15px; }


/* ═══ IV. STÄDEL NAV — LIGHT GROUND ═══ */
.site-nav {
  position: sticky; top: 0; z-index: 100;
  background: rgba(255,255,255,0.97);
  -webkit-backdrop-filter: blur(12px);
  backdrop-filter: blur(12px);
  transition: background 0.3s;
}
.nav-inner {
  max-width: 1400px; margin: 0 auto;
  padding: 0 40px; height: 64px;
  display: flex; align-items: center;
}
.wordmark {
  font-family: 'Inter', sans-serif;
  font-weight: 500; font-size: 22px;
  color: #333; letter-spacing: 0.02em;
  flex-shrink: 0; transition: color 0.2s;
}
.wordmark:hover { color: #5c3a1e; }

.nav-links {
  display: flex; align-items: center; gap: 32px;
  list-style: none; padding-left: 0; margin-left: 48px;
  flex-shrink: 0;
}
.nav-links a {
  font-family: 'Inter', sans-serif;
  font-size: 21px;
  font-weight: 500; letter-spacing: 0.02em;
  color: #333; transition: color 0.2s; white-space: nowrap;
}
.nav-links a:hover { color: #5c3a1e; }
.nav-links a.active { /* no underline */ }

.nav-utils {
  display: flex; align-items: center; gap: 12px; margin-left: auto;
}
.nav-utils button, .nav-utils a {
  font-family: 'Inter', sans-serif;
  color: #000; background: none; border: none; cursor: pointer;
  min-height: 44px; padding: 0 8px;
  display: flex; align-items: center; justify-content: center;
  transition: color 0.2s;
}
.nav-utils button:hover, .nav-utils a:hover { color: #5c3a1e; }
.nav-utils svg { stroke: currentColor; fill: none; }
.nav-icon { width: 22px; height: 22px; display: block; }
body.dark-mode #contrastBtn svg { transform: scaleX(-1); }

.nav-hamburger {
  display: flex; flex-direction: column;
  justify-content: center; align-items: center;
  gap: 5px; min-height: 44px; padding: 0 8px;
}
.nav-hamburger span {
  display: block; width: 22px; height: 1.5px;
  background: #333;
  transition: transform 0.25s, opacity 0.2s;
  transform-origin: center;
}
.nav-hamburger.open span:nth-child(1) { transform: translateY(6.5px) rotate(45deg); }
.nav-hamburger.open span:nth-child(2) { opacity: 0; transform: scaleX(0); }
.nav-hamburger.open span:nth-child(3) { transform: translateY(-6.5px) rotate(-45deg); }

.nav-accent-rule {
  display: block; height: 2px; border: none;
  background: linear-gradient(90deg,
    transparent 0%,
    rgba(122,90,74,0.35) 8%, rgba(122,90,74,0.55) 15%, rgba(122,90,74,0.28) 24%,
    rgba(92,58,30,0.45) 34%, rgba(92,58,30,0.65) 44%, rgba(92,58,30,0.28) 54%,
    rgba(122,90,74,0.50) 63%, rgba(160,128,100,0.40) 74%, rgba(160,128,100,0.28) 83%,
    rgba(122,90,74,0.30) 90%, transparent 100%);
}


/* ═══ V. MENU SYSTEM ═══ */

/* Overlay */
.menu-overlay {
  position: fixed; inset: 0; z-index: 200;
  background: rgba(0,0,0,0.45);
  -webkit-backdrop-filter: blur(2px);
  backdrop-filter: blur(2px);
  opacity: 0; pointer-events: none; transition: opacity 0.6s;
}
.menu-overlay.open { opacity: 1; pointer-events: auto; }

/* Accordion strips — desktop, landing pages only */
/* strips right must equal panel width exactly */
.menu-strips {
  position: fixed; top: 0; bottom: 0; left: 0; right: 400px; z-index: 201;
  display: flex; flex-direction: row; overflow: hidden;
  opacity: 0; transition: opacity 0.5s ease 0.15s; pointer-events: none;
}
.menu-strips.open { opacity: 1; pointer-events: auto; }

.strip { flex: 1; position: relative; overflow: hidden; cursor: pointer; transition: flex 1.2s cubic-bezier(0.25, 0.1, 0.25, 1); min-width: 0; }
.strip:hover { flex: 4; }
.strip-bg { position: absolute; inset: 0; background-size: cover; background-position: center; transition: transform 1.4s cubic-bezier(0.25, 0.1, 0.25, 1); }
.strip::after { content: ''; position: absolute; bottom: 0; left: 0; right: 0; height: 30%; z-index: 1; background: linear-gradient(to top, rgba(0,0,0,0.28) 0%, transparent 100%); pointer-events: none; }
.strip:hover .strip-bg { transform: scale(1.04); }
.strip-bottom { position: absolute; bottom: 0; left: 0; right: 0; background: rgba(0,0,0,0.4); -webkit-backdrop-filter: blur(14px); backdrop-filter: blur(14px); padding: 40px 36px 44px; z-index: 2; opacity: 0; transition: opacity 0.8s ease 0.3s; }
.strip:hover .strip-bottom { opacity: 1; }
.strip-content { color: #fff; }
.strip-title { font-family: 'Inter', sans-serif; font-size: 34px; font-weight: 700; line-height: 1.12; margin-bottom: 8px; color: #fff; }
.strip-subtitle { font-family: 'Lora', serif; font-size: 26px; font-weight: 500; color: rgba(255,255,255,0.9); line-height: 1.25; margin-bottom: 14px; }
.strip-buttons { display: flex; gap: 12px; flex-wrap: wrap; }
.strip-btn { display: inline-flex; align-items: center; gap: 8px; font-family: 'Inter', sans-serif; font-size: 17px; font-weight: 500; color: #fff; padding: 10px 20px; border: 1px solid rgba(255,255,255,0.75); border-radius: 0; background: rgba(255,255,255,0.28); -webkit-backdrop-filter: blur(4px); backdrop-filter: blur(4px); letter-spacing: 0.01em; text-decoration: none; transition: all 0.3s; }
.strip-btn:hover { background: rgba(255,255,255,0.40); border-color: #fff; }

/* Strip placeholder tints */
.strip-1 .strip-bg { background: linear-gradient(160deg, #c9bcac 0%, #8a7a6a 100%); }
.strip-2 .strip-bg { background: linear-gradient(160deg, #8BA89A 0%, #5a7a6a 100%); }
.strip-3 .strip-bg { background: linear-gradient(160deg, #D4A574 0%, #a07050 100%); }
.strip-4 .strip-bg { background: linear-gradient(160deg, #7a8aaa 0%, #4a5a7a 100%); }

/* Mobile strip cards — shown at 768px when desktop strips hide */
.mobile-strips { display: none; gap: 10px; margin-bottom: 24px; overflow-x: auto; scrollbar-width: none; -webkit-overflow-scrolling: touch; }
.mobile-strips::-webkit-scrollbar { display: none; }
.mobile-strip-card { flex: 0 0 140px; height: 100px; border-radius: var(--oy-radius); position: relative; overflow: hidden; cursor: pointer; text-decoration: none; border: 1px solid rgba(0,0,0,0.28); }
.mobile-strip-card .strip-bg { position: absolute; inset: 0; border-radius: var(--oy-radius); }
.mobile-strip-card::after { content: ''; position: absolute; inset: 0; background: linear-gradient(to top, rgba(0,0,0,0.5) 0%, transparent 60%); border-radius: var(--oy-radius); }
.mobile-strip-card-text { position: absolute; bottom: 10px; left: 12px; right: 8px; z-index: 2; color: #fff; }
.mobile-strip-card-title { font-family: 'Inter', sans-serif; font-size: 17px; font-weight: 600; line-height: 1.2; margin-bottom: 2px; }
.mobile-strip-card-sub { font-family: 'Lora', serif; font-size: 17px; font-weight: 500; color: rgba(255,255,255,0.75); line-height: 1.2; }

/* Panel — 400px (must match any strips right value) */
.menu-panel {
  position: fixed; top: 0; right: 0; bottom: 0; z-index: 201;
  width: 400px; max-width: 90vw;
  background: #faf6f0; color: #2a2320;
  font-size: 17px; /* freeze — menu is immune to AAA toggle */
  clip-path: inset(16px 20px calc(100% - 68px) calc(100% - 200px) round var(--oy-radius));
  transition: clip-path 0.6s cubic-bezier(0.4, 0, 0.1, 1), opacity 0.2s ease;
  overflow-y: auto; padding: 24px 32px 40px;
  pointer-events: none; opacity: 0;
}
.menu-panel.open {
  clip-path: inset(0 0 0 0 round 0);
  pointer-events: auto; opacity: 1;
}

/* Menu top: ghost wordmark + close */
.menu-top {
  display: flex; align-items: center;
  justify-content: space-between; margin-bottom: 32px;
}
.menu-ghost-wordmark {
  font-family: 'Inter', sans-serif;
  font-size: 22px; font-weight: 500;
  color: #2a2320; opacity: 0.38; letter-spacing: 0.02em;
  user-select: none; pointer-events: none;
}
.menu-close {
  width: 44px; height: 44px;
  display: flex; align-items: center; justify-content: center;
  font-size: 22px; color: #2a2320; cursor: pointer;
  transition: opacity 0.2s; flex-shrink: 0;
}
.menu-close:hover { opacity: 0.62; }

/* Primary nav: Lora 24px / 600 */
.menu-nav-primary { margin-bottom: 4px; }
.menu-nav-primary a {
  font-family: 'Lora', serif;
  font-size: 24px; font-weight: 600;
  color: #2a2320; display: block; padding: 10px 0;
  line-height: 1.2;
  transition: opacity 0.2s;
}
.menu-nav-primary a:hover { opacity: 0.55; }

/* Tan rule: 2px #D4A574 */
.menu-rule-tan {
  height: 2px; border: none;
  background: var(--oy-tan);
  margin: 20px 0;
}

/* Sage rule: 2px #8BA89A */
.menu-rule-sage {
  height: 2px; border: none;
  background: #8BA89A;
  margin: 20px 0;
}

/* "All Info for" label — removed. Structure implies the division. */
.menu-nav-label { display: none; }

/* Secondary nav: Inter 18px / 600 */
.menu-nav-secondary { margin-bottom: 4px; }
.menu-nav-secondary a {
  font-family: 'Inter', sans-serif;
  font-size: 18px; font-weight: 600;
  color: #2a2320; display: block; padding: 4px 0;
  transition: opacity 0.2s;
}
.menu-nav-secondary a:hover { opacity: 0.55; }

/* Tertiary nav: matches secondary exactly */
.menu-nav-tertiary {
  display: block;
  margin-bottom: 4px;
}
.menu-nav-tertiary a {
  font-family: 'Inter', sans-serif;
  font-size: 18px; font-weight: 600;
  color: #2a2320; display: block; padding: 4px 0;
  transition: opacity 0.2s;
}
.menu-nav-tertiary a:hover { opacity: 0.55; }

/* Address: Inter 18px / 500 / #5a4f47 */
.menu-address {
  font-family: 'Inter', sans-serif;
  font-size: 19px; font-weight: 500;
  color: #5a4f47; margin-top: 20px; line-height: 1.6;
}

/* Bottom buttons: uppercase, invert on hover */
.menu-bottom-btns { display: flex; gap: 8px; margin-top: 20px; }
.menu-bottom-btns .menu-btn {
  font-family: 'Inter', sans-serif;
  font-size: 16px; font-weight: 500;
  letter-spacing: 0.06em; text-transform: uppercase;
  color: #2a2320; border: 1px solid rgba(42,35,32,0.40);
  padding: 8px 16px; border-radius: var(--oy-radius);
  background: transparent; cursor: pointer;
  transition: background 0.2s, color 0.2s, border-color 0.2s;
  min-height: 44px;
}
.menu-bottom-btns .menu-btn:hover {
  background: #2a2320; color: #faf8f5; border-color: #2a2320;
}

/* Landing pages: mobile strips shown at 768px */


/* ═══ VI. SCROLL REVEAL ═══ */
.reveal { opacity: 0; transition: opacity 1s ease; }
.reveal-slow { opacity: 0; transition: opacity 2s ease; }
.reveal.visible, .reveal-slow.visible { opacity: 1; }


/* ═══ VII. SHARED RESPONSIVE ═══ */
@media (max-width: 1100px) {
  .nav-links { display: none; }
}
@media (max-width: 1024px) {
  /* Reading page: no layout shift at 1024 — placeholder for card-grid pages */
}
@media (max-width: 768px) {
  .nav-inner { padding: 0 24px; }
  .menu-strips { display: none; }
  .mobile-strips { display: flex; }
  .menu-panel { width: 100%; max-width: 100%; }
  .reveal { transition: opacity 0.6s ease; }
  .reveal-slow { transition: opacity 1s ease; }
}
@media (max-width: 480px) {
  .nav-utils { margin-left: auto; gap: 10px; }
  .nav-utils button, .nav-utils a, .nav-hamburger { padding: 0; }

  .nav-inner { padding: 0 24px; }
}


/* ═══ VIII. SAFE AREA ═══ */
.bottom-safe { padding-bottom: env(safe-area-inset-bottom, 0px); }


/* ═══ IX. DARK MODE — toggle from light ground ═══ */
/* JS: body.classList.toggle('dark-mode') */

body.dark-mode {
  background: linear-gradient(to bottom,
    #000000 0%, #000000 5%, #020203 12%, #040507 20%,
    #060810 30%, #080a13 40%, #0a0d16 50%, #0b0f18 60%,
    #0d111b 70%, #0e121d 80%, #10141f 90%, #111521 100%);
  background-attachment: fixed;
  min-height: 100vh;
  color: rgba(232,224,214,0.88);
}

/* Nav overrides — dark mode */
body.dark-mode .site-nav {
  background: rgba(0,0,0,0.92);
  -webkit-backdrop-filter: blur(12px);
  backdrop-filter: blur(12px);
}
body.dark-mode .wordmark { color: rgba(232,224,214,0.68); }
body.dark-mode .wordmark:hover { color: rgba(232,224,214,0.88); }
body.dark-mode .nav-links a { color: rgba(232,224,214,0.68); }
