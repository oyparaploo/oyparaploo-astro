<div class="bottom-safe"></div>

<script is:inline>
// ── Font size (3 steps)
var sizeStep = 1;
var fontBtn = document.getElementById('fontSizeBtn');
var sizeSpans = fontBtn.querySelectorAll('.sz');
fontBtn.addEventListener('click', function() {
  sizeStep = sizeStep >= 3 ? 1 : sizeStep + 1;
  document.documentElement.classList.remove('size-1', 'size-2', 'size-3');
  document.documentElement.classList.add('size-' + sizeStep);
  sizeSpans.forEach(function(s) { s.classList.toggle('active', parseInt(s.dataset.size) === sizeStep); });
});

// ── Contrast toggle — dark ground native: toggles to light-mode (◑ → ◐)
document.getElementById('contrastBtn').addEventListener('click', function() {
  document.body.classList.toggle('light-mode');
  this.textContent = document.body.classList.contains('light-mode') ? '◐' : '◑';
});

// ── Menu open/close
var navHamburger = document.getElementById('navHamburger');
var menuCloseBtn = document.getElementById('menuCloseBtn');
var menuOverlay  = document.getElementById('menuOverlay');
var menuPanel    = document.getElementById('menuPanel');
function openMenu() {
  menuOverlay.classList.add('open'); menuPanel.classList.add('open'); navHamburger.classList.add('open');
  navHamburger.setAttribute('aria-expanded', 'true'); menuPanel.setAttribute('aria-hidden', 'false');
  menuOverlay.setAttribute('aria-hidden', 'false'); document.body.style.overflow = 'hidden';
}
function closeMenu() {
  menuOverlay.classList.remove('open'); menuPanel.classList.remove('open'); navHamburger.classList.remove('open');
  navHamburger.setAttribute('aria-expanded', 'false'); menuPanel.setAttribute('aria-hidden', 'true');
  menuOverlay.setAttribute('aria-hidden', 'true'); document.body.style.overflow = '';
}
navHamburger.addEventListener('click', openMenu);
menuCloseBtn.addEventListener('click', closeMenu);
menuOverlay.addEventListener('click', closeMenu);
document.addEventListener('keydown', function(e) { if (e.key === 'Escape') closeMenu(); });
menuPanel.querySelectorAll('a').forEach(function(a) { a.addEventListener('click', closeMenu); });

// ── Scroll reveal
(function() {
  var els = document.querySelectorAll('.reveal');
  if (!els.length) return;
  var obs = new IntersectionObserver(function(entries) {
    entries.forEach(function(entry) { if (entry.isIntersecting) { entry.target.classList.add('visible'); obs.unobserve(entry.target); } });
  }, { threshold: 0.05, rootMargin: '0px 0px -30px 0px' });
  els.forEach(function(el) { obs.observe(el); });
})();

// ── Cluster shelves — accordion of category shelves (+ an "All" shelf), mirroring the
//    feel page. Single-open: opening a shelf closes the rest. Each shelf owns its own
//    12/page pager. Single-category clusters render one grid directly (no shelf list).
//    The ≤12 cap holds in every state — the server renders cards past index 12 with the
//    native `hidden` attribute, and the pager only ever reveals a 12-slice, never more.
(function() {
  var PAGE = 12;

  function makePager(root) {
    if (!root) return null;
    var grid = root.querySelector('.cli-grid');
    if (!grid) return null;
    var cards = Array.prototype.slice.call(grid.querySelectorAll('.pc-card'));
    var pager = root.querySelector('.cli-pager');
    var prev = root.querySelector('[data-role="prev"]');
    var next = root.querySelector('[data-role="next"]');
    var info = root.querySelector('.cli-pageinfo');
    var page = 0;
    var pageCount = Math.max(1, Math.ceil(cards.length / PAGE));
    function render() {
      if (page > pageCount - 1) page = pageCount - 1;
      if (page < 0) page = 0;
      cards.forEach(function(c) { c.hidden = true; });
      cards.slice(page * PAGE, page * PAGE + PAGE).forEach(function(c) { c.hidden = false; });
      if (pager) {
        pager.hidden = (pageCount <= 1);
        if (info) info.textContent = (page + 1) + ' / ' + pageCount;
        if (prev) prev.disabled = (page === 0);
        if (next) next.disabled = (page >= pageCount - 1);
      }
    }
    if (prev) prev.addEventListener('click', function() { if (page > 0) { page--; render(); } });
    if (next) next.addEventListener('click', function() { page++; render(); });
    return { render: render, reset: function() { page = 0; render(); } };
  }

  var shelves = Array.prototype.slice.call(document.querySelectorAll('.cli-shelf'));
  if (shelves.length) {
    var items = shelves.map(function(shelf) {
      var panel = shelf.querySelector('.cli-shelf-panel');
      return { btn: shelf.querySelector('.cli-shelf-toggle'), panel: panel, pager: makePager(panel) };
    });
    function setOpen(it, open) {
      it.btn.setAttribute('aria-expanded', open ? 'true' : 'false');
      it.panel.hidden = !open;
      if (open && it.pager) it.pager.reset();
    }
    items.forEach(function(it) {
      it.btn.addEventListener('click', function() {
        var was = it.btn.getAttribute('aria-expanded') === 'true';
        items.forEach(function(o) { setOpen(o, false); });
        if (!was) {
          setOpen(it, true);
          // Opening collapses any previously-open shelf, so page height shifts. Anchor the
          // newly-opened shelf to the top — its title just below the sticky nav — so every
          // shelf opens to the beginning of its own cards. On open only, never on close.
          var nav = document.querySelector('.site-nav');
          var navH = nav ? nav.offsetHeight : 0;
          var y = it.btn.getBoundingClientRect().top + window.pageYOffset - navH - 8;
          window.scrollTo({ top: y < 0 ? 0 : y, behavior: 'smooth' });
        }
      });
    });
  } else {
    var single = document.querySelector('.cli-single');
    var p = makePager(single);
    if (p) p.render();
  }
})();
</script>

<!-- ═══ SEARCH OVERLAY ═══ -->
<div class="oy-search" id="oySearch" role="dialog" aria-modal="true" aria-label="Search the writing" aria-hidden="true">
