    </div>
  ) : (
    <div class="cli-single">
      <div class="cli-grid">
        {pieces.map((p, i) => (
          <a class="pc-card" href={`/writing/${p.slug}/`} data-cat={p.catSlug} hidden={i >= CAP}>
            <div class="pc-title">{p.title}</div>
            <div class="pc-excerpt">{p.excerpt}</div>
          </a>
        ))}
      </div>
      {pieces.length > CAP && (
        <div class="cli-controls">
          <div class="cli-pager" hidden>
            <button type="button" class="cli-btn" data-role="prev" aria-label="Previous page">‹ previous</button>
            <span class="cli-pageinfo" aria-live="polite"></span>
