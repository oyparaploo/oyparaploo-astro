@media (max-width: 1024px) { .cli-grid { grid-template-columns: repeat(2, 1fr); } }
@media (max-width: 768px) { .cli-container { padding: 0 24px; } .cli-grid { grid-template-columns: 1fr; } .cli-hero { padding: 48px 0 28px; } }
