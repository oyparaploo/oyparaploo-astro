// Good Grounds portrait images — drop .webp files into src/images/portraits/good-grounds/
// named by artist-slug (see navigation-rebuild/good-grounds-image-filenames.md). Build-time
// glob: a card with a matching file shows the photo; otherwise it keeps its placeholder
// (missing files fall back cleanly, no 404/broken-image). Touches Good Grounds cards only.
const ggImages = import.meta.glob('../images/portraits/good-grounds/*.webp', { eager: true, query: '?url', import: 'default' });
const ggMap = {};
for (const k in ggImages) { ggMap[k.split('/').pop().replace(/\.webp$/, '')] = ggImages[k]; }
function ggSlug(name) {
  return name.normalize('NFKD').replace(/[̀-ͯ]/g, '').toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '');
}
