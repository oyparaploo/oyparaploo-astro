    ["33f97981-a0e5-4f25-6b71-db179aa27000",51],["51535210-4d19-4f2d-98e8-c3d620c4cb00",52],["c795a9cd-78ac-48a9-956b-8324002d5100",53],["72e61dfd-8e9e-4c7f-23bc-3502fdf5a300",54],["e83e5692-6d78-4e44-7fe7-75ffe7fe5d00",55],["cc140a7f-4337-4428-2360-8efc90ad2400",56],["bab48e6a-3cb3-4341-b09e-c5a870dc1800",57]
  ];
  var ids = items.map(function (it) { return it[0]; });
  var nums = items.map(function (it) { return it[1]; });

  var field = document.getElementById("field");
  var box = document.getElementById("box");
  var boxCap = document.getElementById("boxCap");
  var slides = [document.getElementById("slideA"), document.getElementById("slideB")];
  var imgs = [slides[0].querySelector("img"), slides[1].querySelector("img")];
  var specks = [];

  function url(id) { return "https://imagedelivery.net/" + HASH + "/" + id + "/public"; }
  function urlFull(id) { return "https://imagedelivery.net/" + HASH + "/" + id + "/full"; }

  // Lay down every image once, at a readable size. The field flows down and
  // scrolls — no screen-height guessing, so it can't come up short on any phone.
  function buildField() {
    field.innerHTML = "";
    specks = [];
    ids.forEach(function (id, i) {
      var b = document.createElement("button");
      b.className = "speck";
      b.style.backgroundImage = "url(" + url(id) + ")";
      b.setAttribute("aria-label", GATHERING + " " + nums[i]);
      (function (idx, el) { el.addEventListener("click", function () { open(idx, el); }); })(i, b);
      specks.push(b);
      field.appendChild(b);
    });
  }
  // (buildField is called at the very end, after all handlers are defined)

  var current = 0;      // index showing now
  var active = 0;       // which slide layer is on top
  var timer = null;
  var HOLD = 3200;      // ms each image rests before dissolving
  var playing = false;

  function pad(n) { return n < 10 ? "0" + n : "" + n; }

  function paint(i) {
    var next = 1 - active;
    imgs[next].src = urlFull(ids[i]);
    slides[next].classList.add("show");
    slides[active].classList.remove("show");
    active = next;
    current = i;
    boxCap.textContent = pad(nums[i]) + " / " + pad(nums[nums.length - 1]);
  }

  function advance() {
    paint((current + 1) % ids.length);   // loops
  }

  function schedule() {
    clearTimeout(timer);
    if (playing) timer = setTimeout(function () { advance(); schedule(); }, HOLD);
  }

  var clickedSpeck = null;

  function open(i, speckEl) {
    specks.forEach(function (s) { s.classList.remove("marked"); });
    clickedSpeck = speckEl || null;
    box.classList.add("open");
    slides[0].classList.remove("show");
    slides[1].classList.remove("show");
    active = 1;                 // so first paint lands on layer 0
    paint(i);
    setPlaying(true);           // opens playing; Go active
    // reveal the tap hint briefly on open so the visitor learns it, then let state govern
    var hint = document.querySelector(".tap-hint");
    hint.classList.add("visible");
    setTimeout(function () { if (playing) hint.classList.remove("visible"); }, 8000);
  }

  function close() {
    playing = false;
    clearTimeout(timer);
    box.classList.remove("open");
    specks.forEach(function (s) { s.classList.remove("marked"); });
    if (clickedSpeck) {
      clickedSpeck.classList.add("marked");
      clickedSpeck.scrollIntoView({ block: "center", behavior: "smooth" });
    }
  }

  var stopBtn = document.getElementById("stopBtn");
  var goBtn = document.getElementById("goBtn");
  var stage = document.getElementById("stage");

  function setPlaying(on) {
    playing = on;
    document.querySelector(".tap-hint").classList.toggle("visible", !on);
    schedule();
  }

  goBtn.addEventListener("click", function (e) { e.stopPropagation(); setPlaying(true); });
  stopBtn.addEventListener("click", function (e) { e.stopPropagation(); setPlaying(false); });
  document.getElementById("leaveBtn").addEventListener("click", function (e) {
    e.stopPropagation();
    close();
  });

  // clicking the image advances by hand, but only when stopped — matches the hint
  stage.addEventListener("click", function () {
    if (!playing) { advance(); }
  });

  document.addEventListener("keydown", function (e) {
    if (!box.classList.contains("open")) return;
    if (e.key === "Escape") close();
    else if (e.key === "ArrowRight") { advance(); schedule(); }
    else if (e.key === "ArrowLeft") { paint((current - 1 + ids.length) % ids.length); schedule(); }
    else if (e.key === " ") { e.preventDefault(); setPlaying(!playing); }
  });

  // AAA font-size toggle (Städel nav requirement)
  document.querySelectorAll(".sz").forEach(function (btn) {
    btn.addEventListener("click", function () {
      document.querySelectorAll(".sz").forEach(function (b) { b.classList.remove("active"); });
      btn.classList.add("active");
      var sizes = { "1": "17px", "2": "18px", "3": "20px" };
      document.documentElement.style.setProperty("--root-size", sizes[btn.dataset.size]);
      document.documentElement.className = "size-" + btn.dataset.size;
    });
  });

  // ---------- menu ----------
  var menuBtn = document.getElementById("menuBtn");
  var menuPanel = document.getElementById("menuPanel");
  var menuOverlay = document.getElementById("menuOverlay");
  var menuClose = document.getElementById("menuClose");

  function setMenu(on) {
    menuPanel.classList.toggle("open", on);
    menuOverlay.classList.toggle("open", on);
    menuBtn.setAttribute("aria-expanded", on ? "true" : "false");
    menuPanel.setAttribute("aria-hidden", on ? "false" : "true");
    menuOverlay.setAttribute("aria-hidden", on ? "false" : "true");
    document.body.style.overflow = on ? "hidden" : "";
  }
  menuBtn.addEventListener("click", function () {
    setMenu(!menuPanel.classList.contains("open"));
  });
  menuClose.addEventListener("click", function () { setMenu(false); });
  menuOverlay.addEventListener("click", function () { setMenu(false); });
  menuPanel.querySelectorAll("a").forEach(function (a) {
    a.addEventListener("click", function () { setMenu(false); });
  });

  // ---------- search ----------
  var searchBtn = document.getElementById("searchBtn");
  var searchOverlay = document.getElementById("searchOverlay");
  var searchClose = document.getElementById("searchClose");
  var searchInput = document.getElementById("searchInput");

  function setSearch(on) {
    searchOverlay.classList.toggle("open", on);
    searchOverlay.setAttribute("aria-hidden", on ? "false" : "true");
    if (on) { setTimeout(function () { searchInput.focus(); }, 60); }
    else { searchInput.blur(); }
  }
  searchBtn.addEventListener("click", function () {
    setSearch(!searchOverlay.classList.contains("open"));
  });
  searchClose.addEventListener("click", function () { setSearch(false); });

  // ---------- contrast ----------
  document.getElementById("contrastBtn").addEventListener("click", function () {
    document.body.classList.toggle("light-mode");
  });

  // Escape closes menu and search
  document.addEventListener("keydown", function (e) {
    if (e.key !== "Escape") return;
    if (menuPanel.classList.contains("open")) setMenu(false);
    if (searchOverlay.classList.contains("open")) setSearch(false);
  });

  // build the mosaic now that everything it needs exists
  buildField();
</script>

</body>
</html>
