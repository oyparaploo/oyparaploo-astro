<!DOCTYPE html>
<html lang="en" class="size-1">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Speck Field — paraploo, the elder</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Lora:ital,wght@0,400..700;1,400&family=Inter:wght@400..600&display=swap" rel="stylesheet">
<style is:global>
  :root { --root-size: 17px; }
  * { margin: 0; padding: 0; box-sizing: border-box; }
  * { font-style: normal; }
  html { font-size: var(--root-size); -webkit-text-size-adjust: 100%; }
  body {
    font-family: 'Inter', sans-serif;
    background: #0d0907;
    color: rgba(232,224,214,0.85);
    overflow-x: hidden;
    overflow-wrap: break-word;
    touch-action: manipulation;
    -webkit-tap-highlight-color: rgba(232,224,214,0.12);
  }

  /* ---------- light mode (contrast toggle) ---------- */
  body.light-mode { background: #fffdf9; color: #2a2320; }
  body.light-mode nav { background: rgba(255,255,255,0.97); }
  body.light-mode .wordmark { color: #333333; }
  body.light-mode .wordmark:hover { color: #5c3a1e; }
  body.light-mode .nav-links a { color: #333333; }
  body.light-mode .nav-links a:hover { color: #5c3a1e; }
  body.light-mode .icon-btn { color: #333333; }
  body.light-mode .burger span { background: #333333; }
  body.light-mode .hd .g { color: #5a4f47; }
  body.light-mode .field { background: #fffdf9; }
  p, h1, h2 { text-wrap: pretty; }

  /* ---------- nav ---------- */
  nav {
    position: sticky; top: 0; z-index: 50;
    background: rgba(0,0,0,0.92);
    -webkit-backdrop-filter: blur(12px); backdrop-filter: blur(12px);
    height: 64px; display: flex; align-items: center;
  }
  .nav-inner {
    width: 100%; max-width: 1400px; margin: 0 auto; padding: 0 40px;
    display: flex; align-items: center; justify-content: space-between;
  }
  .wordmark {
    font-family: 'Lora', serif; font-weight: 600; font-size: 21px;
    letter-spacing: 0.02em; color: rgba(232,224,214,0.78); text-decoration: none;
    flex-shrink: 0;
  }
  .wordmark:hover { color: rgba(232,224,214,0.96); }
  .nav-links { display: flex; align-items: center; gap: 32px; list-style: none; margin-left: 48px; }
  .nav-links a {
    font-family: 'Inter', sans-serif; font-size: 16px; font-weight: 500;
    letter-spacing: 0.02em; color: rgba(232,224,214,0.68); text-decoration: none;
  }
  .nav-links a:hover { color: rgba(232,224,214,0.96); }
  @media (max-width: 1100px) { .nav-links { display: none; } }
  .nav-utils { display: flex; align-items: center; gap: 18px; margin-left: 24px; }
  .sz-group { display: flex; align-items: flex-end; gap: 0; }
  .sz {
    font-family: 'Inter', sans-serif; font-weight: 600;
    color: rgba(232,224,214,0.66); background: none; border: none; cursor: pointer;
    line-height: 1; min-height: 44px;
    display: flex; align-items: flex-end; justify-content: center;
    padding: 0 2px 12px;
    transition: color 0.18s ease;
  }
  .sz:hover { color: rgba(232,224,214,0.78); }
  .sz.active { color: rgba(232,224,214,0.78); }
  body.light-mode .sz { color: #5a4f47; }
  body.light-mode .sz:hover { color: #333333; }
  body.light-mode .sz.active { color: #333333; }
  .sz[data-size="1"] { font-size: 14px; }
  .sz[data-size="2"] { font-size: 17px; }
  .sz[data-size="3"] { font-size: 20px; }
  .icon-btn {
    background: none; border: none; color: rgba(232,224,214,0.85); cursor: pointer;
    min-height: 44px; min-width: 44px; display: flex; align-items: center; justify-content: center;
  }
  .burger { display: flex; flex-direction: column; gap: 5px; }
  .burger span { width: 22px; height: 1.5px; background: rgba(232,224,214,0.85); display: block; }
  .accent-rule { height: 1px; background: linear-gradient(90deg, transparent, rgba(85,85,85,0.55), transparent); }

  /* ---------- header ---------- */
  header.hd { max-width: 1400px; margin: 0 auto; padding: 54px 40px 30px; }
  .hd .g {
    font-size: 1rem; font-weight: 500; letter-spacing: 0.12em;
    text-transform: uppercase; color: rgba(232,224,214,0.62);
  }

  /* ---------- the field ---------- */
  /* Specks are a fraction of screen width via a fixed column count, so they're
     always a readable size on any device — no pixel guessing. The field simply
     flows down and scrolls; it never needs to "fill exactly one screen". */
  .field {
    width: 100%; margin: 0; padding: 0;
    display: grid;
    grid-template-columns: repeat(12, 1fr);   /* desktop: 12 across */
    gap: 0;
    background: #0d0907;
  }
  @media (max-width: 1024px) { .field { grid-template-columns: repeat(8, 1fr); } }
  @media (max-width: 1000px) { .field { grid-template-columns: repeat(8, 1fr); } }
  @media (max-width: 640px)  { .field { grid-template-columns: repeat(4, 1fr); } }  /* phone: 4 across, readable */
  .speck {
    width: 100%; aspect-ratio: 1;
    display: block;
    border: none; padding: 0; margin: 0; cursor: pointer;
    background-size: cover; background-position: center;
    border-radius: 0;
    filter: saturate(0.82) brightness(0.84);
    transition: transform 0.7s cubic-bezier(0.45, 0, 0.55, 1),
                filter 0.7s cubic-bezier(0.45, 0, 0.55, 1),
                border-radius 0.7s cubic-bezier(0.45, 0, 0.55, 1),
                box-shadow 0.7s cubic-bezier(0.45, 0, 0.55, 1);
    position: relative;
  }
  .speck:hover, .speck:focus-visible {
    transform: scale(2.4);
    filter: saturate(1) brightness(1);
    z-index: 5;
    box-shadow: 0 6px 22px rgba(0,0,0,0.6);
    outline: none;
    border-radius: 6px;
  }
  .speck.marked {
    box-shadow: inset 0 0 0 2px #ff6a1a, 0 0 10px 1px rgba(255,106,26,0.65);
    z-index: 3;
  }

  /* ---------- slideshow ---------- */
  .box {
    position: fixed; inset: 0; z-index: 100;
    height: 100vh; height: 100dvh;
    background: #060403;
    display: none; flex-direction: column;
    overflow: hidden;
  }
  .box.open { display: flex; }
  .bar {
    flex: 0 0 auto; height: 56px;
    display: flex; align-items: center; justify-content: space-between;
    padding: 0 26px; z-index: 4;
    border-bottom: 1px solid rgba(232,224,214,0.35);
  }
  .bar .controls { display: flex; align-items: center; gap: 26px; }
  .ctl {
    background: none; border: none; cursor: pointer;
    font-family: 'Inter', sans-serif; font-size: 0.94rem; font-weight: 500;
    letter-spacing: 0.14em; text-transform: uppercase;
    color: rgba(232,224,214,0.62); padding: 8px 0;
    min-height: 44px; display: flex; align-items: center;
    transition: color 0.18s ease;
  }
  .ctl:hover { color: rgba(232,224,214,1); }
  #leaveBtn:hover { color: rgba(232,224,214,1); }
  .bar .count-group { display: flex; align-items: center; gap: 18px; }
  .tap-hint {
    position: absolute; bottom: 20px; left: 26px; z-index: 4;
    font-family: 'Lora', serif; font-style: italic; font-weight: 400;
    font-size: 1.06rem; letter-spacing: 0.02em;
    color: rgba(232,224,214,0.62); pointer-events: none;
    opacity: 0; transition: opacity 0.4s ease;
  }
  .tap-hint.visible { opacity: 1; }
  .bar .count {
    font-family: 'Inter', sans-serif; font-size: 0.94rem; font-weight: 500;
    letter-spacing: 0.14em; color: rgba(232,224,214,0.62);
  }
  .stage {
    flex: 1 1 auto; position: relative;
    margin-top: -14px;
    z-index: 5;
  }
  .slide {
    position: absolute; inset: 0;
    display: flex; align-items: center; justify-content: center;
    opacity: 0;
    transition: opacity 1.1s ease;
    padding: 0 2vw 46px;
    cursor: pointer;
  }
  .slide.show { opacity: 1; }
  .slide img {
    max-width: 97vw; max-height: 100%; object-fit: contain;
    border-radius: 4px;
    box-shadow: 0 20px 60px rgba(0,0,0,0.7);
  }

  @media (max-width: 768px) {
    .nav-inner, header.hd { padding-left: 24px; padding-right: 24px; }
    .speck:hover, .speck:focus-visible { transform: scale(2); }
    .bar { padding: 0 18px; }
    .bar .controls { gap: 18px; }
  }

  /* touch devices: no hover step — a tap opens the slideshow directly. */
  @media (hover: none), (pointer: coarse) {
    .speck { filter: saturate(0.95) brightness(0.95); }
    .speck:hover, .speck:focus-visible,
    .speck:active {
      transform: none;
      filter: saturate(1) brightness(1);
      box-shadow: none;
      z-index: auto;
    }
    .speck.marked {
      box-shadow: inset 0 0 0 2px #ff6a1a, 0 0 10px 1px rgba(255,106,26,0.65);
      z-index: 3;
    }
    .ctl { font-size: 1rem; }
    .slide { padding: 0 1vw 44px; }
    .slide img { max-width: 99vw; max-height: 100%; }
  }

  .icon-btn { transition: color 0.18s ease; }
  #contrastBtn svg { transition: transform 0.25s ease; }
  body.light-mode #contrastBtn svg { transform: scaleX(-1); }

  /* ---------- menu (Städel slide-in) — px only, per spec ---------- */
  .menu-overlay {
    position: fixed; inset: 0; z-index: 90;
    background: rgba(0,0,0,0.45);
    opacity: 0; visibility: hidden;
    transition: opacity 0.3s ease, visibility 0.3s ease;
  }
  .menu-overlay.open { opacity: 1; visibility: visible; }
  .menu-panel {
    position: fixed; top: 0; right: 0; bottom: 0; z-index: 95;
    width: 400px; max-width: 88vw;
    background: #faf6f0;
    transform: translateX(100%);
    transition: transform 0.34s cubic-bezier(0.4, 0, 0.2, 1);
    padding: 34px 40px calc(34px + env(safe-area-inset-bottom, 0px));
    overflow-y: auto;
    display: flex; flex-direction: column;
  }
  .menu-panel.open { transform: translateX(0); }
  .menu-close {
    align-self: flex-end; background: none; border: none; cursor: pointer;
    width: 44px; height: 44px; color: #3d352e;
    display: flex; align-items: center; justify-content: center;
  }
  .menu-links { list-style: none; margin-top: 22px; }
  .menu-links li { border-bottom: 1px solid rgba(61,53,46,0.32); }
  .menu-links a {
    display: flex; align-items: center; min-height: 44px; padding: 12px 0;
    font-family: 'Inter', sans-serif; font-size: 20px; font-weight: 500;
    color: #2a2320; text-decoration: none; letter-spacing: 0.01em;
  }
  .menu-links a:hover { color: #5c3a1e; }

  /* ---------- search (slim drop bar) ---------- */
  .search-overlay {
    position: fixed; top: 65px; left: 0; right: 0; z-index: 96;
    background: rgba(10,7,5,0.94);
    -webkit-backdrop-filter: blur(14px); backdrop-filter: blur(14px);
    border-bottom: 1px solid rgba(232,224,214,0.35);
    transform: translateY(-100%);
    opacity: 0; visibility: hidden;
    transition: transform 0.3s cubic-bezier(0.4,0,0.2,1), opacity 0.22s ease, visibility 0.22s ease;
  }
  .search-overlay.open { transform: translateY(0); opacity: 1; visibility: visible; }
  .search-box {
    max-width: 1400px; margin: 0 auto; padding: 0 40px;
    height: 62px; display: flex; align-items: center; gap: 16px;
  }
  .search-box input {
    flex: 0 1 460px; background: none; border: none;
    border-bottom: 1px solid rgba(232,224,214,0.35);
    font-family: 'Lora', serif; font-size: 18px; font-weight: 400;
    color: rgba(232,224,214,0.88); padding: 6px 0; outline: none;
  }
  .search-box input:focus { border-bottom-color: rgba(232,224,214,0.62); }
  .search-box input::placeholder { color: rgba(232,224,214,0.62); }
  .search-close {
    width: 44px; height: 44px; background: none; border: none; cursor: pointer;
    color: rgba(232,224,214,0.62); flex-shrink: 0; margin-left: auto;
    display: flex; align-items: center; justify-content: center;
  }
  .search-close:hover { color: rgba(232,224,214,1); }
  body.light-mode .search-overlay { background: rgba(255,255,255,0.97); border-bottom-color: rgba(61,53,46,0.32); }
  body.light-mode .search-box input { color: #2a2320; border-bottom-color: rgba(61,53,46,0.32); }
  body.light-mode .search-box input:focus { border-bottom-color: rgba(61,53,46,0.55); }
  body.light-mode .search-box input::placeholder { color: #5a4f47; }
  body.light-mode .search-close { color: #333333; }

  @media (max-width: 768px) {
    .search-box { padding: 0 24px; gap: 10px; }
  }

  @media (max-width: 480px) {
    .menu-panel { width: 100%; max-width: 100%; padding: 28px 24px; }
    .nav-inner { padding: 0 24px; }
  }
</style>
</head>
