---
import PortraitsSub from '../../../layouts/PortraitsSub.astro';
import { GG_GROUPS } from '../../../data/goodGroundsGroups.js';

export function getStaticPaths() {
  return GG_GROUPS.map((g) => ({ params: { group: g.slug }, props: { group: g } }));
}

const { group } = Astro.props;
const title = `Good Grounds · ${group.label} — Paraploo, The Elder`;
---
<PortraitsSub title={title}>
  <section class="territory-zone" id="good-grounds" style="padding-top: 56px;">
    <nav class="section-nav" aria-label="Back to Portraits">
      <a class="sn-link" href="/portraits/#good-grounds">‹ The Portraits · Good Grounds</a>
    </nav>
    <div class="tz-header reveal">
      <span class="tz-name">{group.label}</span>
      <span class="tz-count">{group.cards.length} musicians</span>
    </div>
    <div class="pc-grid reveal">
      {group.cards.map((c) => (
        <a class="pc" href="#"><div class="pc-title">{c.t}</div><div class="pc-artist">{c.a}</div></a>
      ))}
    </div>
    <nav class="section-nav" aria-label="Good Grounds groups" style="margin-top: 48px;">
      {GG_GROUPS.map((g) => (
        g.slug === group.slug
          ? <span class="sn-link" aria-current="page" style="font-weight:600;">{g.label}</span>
          : <a class="sn-link" href={`/portraits/good-grounds/${g.slug}/`}>{g.label}</a>
      ))}
    </nav>
  </section>
</PortraitsSub>
