---
import '@fontsource/inter/400.css';
import '@fontsource/inter/500.css';
import '@fontsource/lora/400.css';
import '@fontsource/lora/500.css';
import '@fontsource/lora/600.css';
import '@fontsource/lora/700.css';
import WindowFrame from '../components/WindowFrame.astro';
---

<!DOCTYPE html>
<html lang="en" class="size-1">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Our Practice — Oyparaploo</title>
<style>
/* ═══ I. RESET ═══ */
*, *::before, *::after { margin: 0; padding: 0; box-sizing: border-box; }
p, h1, h2, h3, h4, li, blockquote { text-wrap: pretty; }
em, i, cite, address, dfn, var { font-style: normal; }
* { font-style: normal; }
a { color: inherit; text-decoration: none; }
a, button, [role="button"], select { touch-action: manipulation; -webkit-tap-highlight-color: transparent; }
button { font-family: inherit; border: none; background: none; cursor: pointer; }
ul, ol { list-style: none; }
img { max-width: 100%; height: auto; display: block; }
html { overflow-x: hidden; scroll-behavior: smooth; font-size: var(--root-size, 18px); -webkit-text-size-adjust: 100%; text-size-adjust: 100%; }
body { font-family: 'Inter', sans-serif; -webkit-font-smoothing: antialiased; overflow-x: hidden; overflow-wrap: break-word; word-break: break-word; transition: background 0.4s ease, color 0.3s ease; background: #f0efed; color: #1a1a1a; min-height: 100vh; }

/* ═══ II. DESIGN TOKENS ═══ */
:root { --oy-sand: #D4C4A8; --oy-tan: #D4A574; --oy-radius: 4px; --soil: #662a1e; }

/* ═══ III. FONT SIZE SYSTEM ═══ */
html.size-1 { --root-size: 18px; } html.size-2 { --root-size: 19px; } html.size-3 { --root-size: 21px; }
.font-size-btn { display: flex; gap: 2px; font-weight: 600; align-items: baseline; }
.font-size-btn .sz { color: #000 !important; opacity: 1; transition: opacity 0.25s, color 0.2s; line-height: 1; }
.font-size-btn .sz.active { opacity: 1; }
.font-size-btn .sz[data-size="1"] { font-size: 20px; }
.font-size-btn .sz[data-size="2"] { font-size: 17px; }
.font-size-btn .sz[data-size="3"] { font-size: 14px; }

/* ═══ IV. STÄDEL NAV — LIGHT GROUND ═══ */
.site-nav { position: sticky; top: 0; z-index: 100; background: rgba(255,255,255,0.97); -webkit-backdrop-filter: blur(12px); backdrop-filter: blur(12px); transition: background 0.3s; }
.nav-inner { max-width: 1400px; margin: 0 auto; padding: 0 40px; height: 64px; display: flex; align-items: center; }
.wordmark { font-family: 'Inter', sans-serif; font-weight: 500; font-size: 22px; color: #333; letter-spacing: 0.02em; flex-shrink: 0; transition: color 0.2s; }
.wordmark:hover { color: #5c3a1e; }
.nav-links { display: flex; align-items: center; gap: 32px; list-style: none; padding-left: 0; margin-left: 48px; flex-shrink: 0; }
.nav-links a { font-family: 'Inter', sans-serif; font-size: 20px; font-weight: 500; letter-spacing: 0.02em; color: #333; transition: color 0.2s; white-space: nowrap; }
.nav-links a:hover { color: #5c3a1e; }
.nav-utils { display: flex; align-items: center; gap: 12px; margin-left: auto; }
.nav-utils button, .nav-utils a { font-family: 'Inter', sans-serif; color: #000; background: none; border: none; cursor: pointer; min-height: 44px; padding: 0 8px; display: flex; align-items: center; justify-content: center; transition: color 0.2s; }
.nav-utils button:hover, .nav-utils a:hover { color: #5c3a1e; }
.font-size-btn:hover .sz { color: #5c3a1e !important; }
.nav-utils svg { stroke: currentColor; fill: none; stroke-width: 2; }
.nav-icon { width: 22px; height: 22px; display: block; }
.nav-hamburger { display: flex; flex-direction: column; justify-content: center; align-items: center; gap: 5px; min-height: 44px; padding: 0 8px; }
.nav-hamburger line { stroke: #333; stroke-width: 2.5; transition: transform 0.25s, opacity 0.2s; transform-box: fill-box; transform-origin: center; }
.nav-hamburger.open line:nth-child(1) { transform: translateY(7px) rotate(45deg); }
.nav-hamburger.open line:nth-child(2) { opacity: 0; }
.nav-hamburger.open line:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }
.nav-accent-rule { display: block; height: 2px; border: none; background: linear-gradient(90deg, transparent 0%, rgba(122,90,74,0.35) 8%, rgba(122,90,74,0.55) 15%, rgba(122,90,74,0.28) 24%, rgba(92,58,30,0.45) 34%, rgba(92,58,30,0.65) 44%, rgba(92,58,30,0.28) 54%, rgba(122,90,74,0.50) 63%, rgba(160,128,100,0.40) 74%, rgba(160,128,100,0.28) 83%, rgba(122,90,74,0.30) 90%, transparent 100%); }

/* ═══ V. MENU SYSTEM ═══ */
.menu-overlay { position: fixed; inset: 0; z-index: 200; background: rgba(0,0,0,0.45); opacity: 0; pointer-events: none; transition: opacity 0.6s; }
.menu-overlay.open { opacity: 1; pointer-events: auto; }
.menu-strips { display: none !important; }
.menu-panel { position: fixed; top: 0; right: 0; bottom: 0; z-index: 201; width: 400px; max-width: 90vw; background: #faf6f0; color: #2a2320; font-size: 17px; clip-path: inset(16px 20px calc(100% - 68px) calc(100% - 200px) round var(--oy-radius)); transition: clip-path 0.6s cubic-bezier(0.4, 0, 0.1, 1), opacity 0.2s ease; overflow-y: auto; padding: 24px 32px 40px; pointer-events: none; opacity: 0; }
.menu-panel.open { clip-path: inset(0 0 0 0 round 0); pointer-events: auto; opacity: 1; }
.menu-top { display: flex; align-items: center; justify-content: space-between; margin-bottom: 32px; }
.menu-ghost-wordmark { font-family: 'Inter', sans-serif; font-size: 22px; font-weight: 500; color: #2a2320; opacity: 0.38; letter-spacing: 0.02em; user-select: none; pointer-events: none; }
.menu-close { width: 44px; height: 44px; display: flex; align-items: center; justify-content: center; font-size: 22px; color: #2a2320 !important; cursor: pointer; transition: opacity 0.2s; flex-shrink: 0; }
.menu-close:hover { opacity: 0.62; }
.menu-nav-primary { margin-bottom: 4px; }
.menu-nav-primary a { font-family: 'Lora', serif; font-size: 24px; font-weight: 600; color: #2a2320; display: block; padding: 10px 0; line-height: 1.2; transition: opacity 0.2s; }
.menu-nav-primary a:hover { opacity: 0.55; }
.menu-rule-tan { height: 2px; border: none; background: var(--oy-tan); margin: 20px 0; }
.menu-rule-sage { height: 2px; border: none; background: #8BA89A; margin: 20px 0; }
.menu-nav-secondary { margin-bottom: 4px; }
.menu-nav-secondary a { font-family: 'Inter', sans-serif; font-size: 18px; font-weight: 600; color: #2a2320; display: block; padding: 4px 0; transition: opacity 0.2s; }
.menu-nav-secondary a:hover { opacity: 0.55; }
.menu-nav-tertiary { display: block; margin-bottom: 4px; }
.menu-nav-tertiary a { font-family: 'Inter', sans-serif; font-size: 18px; font-weight: 600; color: #2a2320; display: block; padding: 4px 0; transition: opacity 0.2s; }
.menu-nav-tertiary a:hover { opacity: 0.55; }
.menu-address { font-family: 'Inter', sans-serif; font-size: 19px; font-weight: 500; color: #5a4f47; margin-top: 20px; line-height: 1.6; }
.menu-bottom-btns { display: flex; gap: 8px; margin-top: 20px; }
.menu-bottom-btns .menu-btn { font-family: 'Inter', sans-serif; font-size: 16px; font-weight: 500; letter-spacing: 0.06em; text-transform: uppercase; color: #2a2320; border: 1px solid #b3aba6; padding: 8px 16px; border-radius: var(--oy-radius); background: transparent; cursor: pointer; transition: background 0.2s, color 0.2s, border-color 0.2s; min-height: 44px; }
.menu-bottom-btns .menu-btn:hover { background: #2a2320; color: #faf8f5; border-color: #2a2320; }
.mobile-strips { display: none !important; }

/* ═══ VI. PAGE CONTENT — OUR PRACTICE ═══ */
.sidebar-label { position: fixed; left: 20px; top: 50%; transform: rotate(-90deg) translateX(-50%); transform-origin: 0 0; font-family: 'Inter', sans-serif; font-size: 0.9444rem; font-weight: 600; color: #999; letter-spacing: 0.08em; text-transform: uppercase; z-index: 10; }
.three-col { display: grid; grid-template-columns: 280px 1fr 360px; gap: 0; min-height: calc(100vh - 64px); margin-left: 60px; }
.col-left { padding: 40px 32px; border-right: 1px solid #d8d4d0; }
.cl-section { margin-bottom: 32px; }
.cl-title { font-family: 'Inter', sans-serif; font-size: 0.9444rem; font-weight: 700; color: #1a1a1a; margin-bottom: 12px; }
.cl-text { font-family: 'Inter', sans-serif; font-size: 0.9444rem; font-weight: 400; color: #555; line-height: 1.7; }
.cl-text a { text-decoration: underline; text-underline-offset: 3px; }
.cl-text a:hover { color: var(--soil); }
.cl-pills { display: flex; gap: 8px; flex-wrap: wrap; margin-bottom: 24px; }
.cl-pill { font-family: 'Inter', sans-serif; font-size: 0.9444rem; font-weight: 500; color: #1a1a1a; padding: 6px 16px; border: 1px solid #ccc; transition: all 0.2s; }
.cl-pill:hover { border-color: #1a1a1a; }
.col-center { padding: 40px 40px; }
.cc-title { font-family: 'Lora', serif; font-size: 1.3333rem; font-weight: 700; color: #1a1a1a; margin-bottom: 24px; }
.cv-table { width: 100%; }
.cv-row { display: grid; grid-template-columns: 80px 1fr; gap: 16px; padding: 10px 0; border-bottom: 1px solid #e8e4e0; }
.cv-row:first-child { border-top: 1px solid #e8e4e0; }
.cv-year { font-family: 'Inter', sans-serif; font-size: 0.9444rem; font-weight: 600; color: #999; }
.cv-desc { font-family: 'Inter', sans-serif; font-size: 0.9444rem; font-weight: 400; color: #1a1a1a; line-height: 1.5; }
.cc-sub-title { font-family: 'Lora', serif; font-size: 1.1111rem; font-weight: 700; color: #1a1a1a; margin: 40px 0 16px; }
.cc-prose { font-family: 'Inter', sans-serif; font-size: 0.9444rem; font-weight: 400; color: #555; line-height: 1.7; margin-bottom: 16px; }
.col-right { padding: 40px 40px; border-left: 1px solid #d8d4d0; }
.cr-portrait { aspect-ratio: 3/4; background: linear-gradient(145deg, #8a7a6a 0%, #5a4a3a 100%); margin-bottom: 12px; }
.cr-caption { font-family: 'Inter', sans-serif; font-size: 0.9444rem; font-weight: 400; color: #999; margin-bottom: 32px; }
.cr-bio { font-family: 'Inter', sans-serif; font-size: 0.9444rem; font-weight: 400; color: #333; line-height: 1.8; }
.cr-bio p { margin-bottom: 1.2em; }
.colophon { margin-top: 40px; padding-top: 24px; border-top: 1px solid #d8d4d0; }
.colophon-title { font-family: 'Inter', sans-serif; font-size: 0.9444rem; font-weight: 700; color: #1a1a1a; margin-bottom: 8px; }
.colophon-text { font-family: 'Inter', sans-serif; font-size: 0.9444rem; color: #999; line-height: 1.6; }

/* ═══ VII. RESPONSIVE ═══ */
@media (max-width: 1100px) {
  .nav-links { display: none; }
  .three-col { grid-template-columns: 1fr 1fr; margin-left: 0; }
  .col-left { grid-column: 1 / -1; border-right: none; border-bottom: 1px solid #d8d4d0; display: flex; gap: 40px; flex-wrap: wrap; }
  .sidebar-label { display: none; }
}
@media (max-width: 768px) {
  .nav-inner { padding: 0 24px; }
  .menu-panel { width: 100%; max-width: 100%; }
  .three-col { grid-template-columns: 1fr; }
  .col-right { border-left: none; border-top: 1px solid #d8d4d0; }
  .col-left, .col-center, .col-right { padding: 24px; }
}
@media (max-width: 480px) {
  .nav-inner { padding: 0 24px; }
  .nav-utils { margin-left: auto; gap: 10px; }
  .nav-utils button, .nav-utils a, .nav-hamburger { padding: 0; }
}

/* ═══ VIII. DARK MODE ═══ */
body.dark-mode { background: linear-gradient(to bottom, #000000 0%, #000000 5%, #020203 12%, #040507 20%, #060810 30%, #080a13 40%, #0a0d16 50%, #0b0f18 60%, #0d111b 70%, #0e121d 80%, #10141f 90%, #111521 100%); background-attachment: fixed; min-height: 100vh; color: rgba(232,224,214,0.88); }
body.dark-mode .site-nav { background: rgba(0,0,0,0.92); -webkit-backdrop-filter: blur(12px); backdrop-filter: blur(12px); }
body.dark-mode .wordmark { color: rgba(232,224,214,0.68); }
body.dark-mode .wordmark:hover { color: rgba(232,224,214,0.88); }
body.dark-mode .nav-links a { color: rgba(232,224,214,0.68); }
body.dark-mode .nav-links a:hover { color: rgba(232,224,214,0.88); }
body.dark-mode .nav-utils button, body.dark-mode .nav-utils a { color: rgba(232,224,214,0.68); }
body.dark-mode .nav-utils button:hover, body.dark-mode .nav-utils a:hover { color: rgba(232,224,214,0.88); }
body.dark-mode .nav-hamburger line { stroke: rgba(232,224,214,0.68); }
body.dark-mode #contrastBtn svg { transform: scaleX(-1); }
body.dark-mode .font-size-btn .sz { color: rgba(232,224,214,0.68) !important; }
body.dark-mode .font-size-btn:hover .sz { color: rgba(232,224,214,0.88) !important; }
body.dark-mode .nav-accent-rule { opacity: 0.6; }
body.dark-mode .sidebar-label { color: #a09888; }
body.dark-mode .col-left { border-right-color: #3a3430; border-bottom-color: #3a3430; }
body.dark-mode .col-right { border-left-color: #3a3430; border-top-color: #3a3430; }
body.dark-mode .cl-title { color: #d0c8bf; }
body.dark-mode .cl-text { color: #b5ada5; }
body.dark-mode .cl-text a:hover { color: #e8e0d8; }
body.dark-mode .cl-pill { color: #d0c8bf; border-color: #3a3430; }
body.dark-mode .cl-pill:hover { border-color: #5a5048; }
body.dark-mode .cc-title { color: #d0c8bf; }
body.dark-mode .cv-row { border-bottom-color: #3a3430; }
body.dark-mode .cv-row:first-child { border-top-color: #3a3430; }
body.dark-mode .cv-year { color: #a09888; }
body.dark-mode .cv-desc { color: #d0c8bf; }
body.dark-mode .cc-sub-title { color: #d0c8bf; }
body.dark-mode .cc-prose { color: #b5ada5; }
body.dark-mode .cr-caption { color: #a09888; }
body.dark-mode .cr-bio { color: #ccc5bc; }
body.dark-mode .colophon { border-top-color: #3a3430; }
body.dark-mode .colophon-title { color: #d0c8bf; }
body.dark-mode .colophon-text { color: #a09888; }

/* ═══ IX. CANONICAL SITE FOOTER (locked 2026-06-13) — light-native ═══ */
.site-footer{background:rgba(0,0,0,0.03);}
.footer-accent-rule{display:block;height:2px;border:none;background:linear-gradient(90deg,transparent 0%,rgba(122,90,74,0.35) 8%,rgba(122,90,74,0.55) 15%,rgba(122,90,74,0.28) 24%,rgba(92,58,30,0.45) 34%,rgba(92,58,30,0.65) 44%,rgba(92,58,30,0.28) 54%,rgba(122,90,74,0.50) 63%,rgba(160,128,100,0.40) 74%,rgba(160,128,100,0.28) 83%,rgba(122,90,74,0.30) 90%,transparent 100%);opacity:.6;}
.footer-inner{max-width:1400px;margin:0 auto;padding:56px 40px 44px;font-family:'Inter',sans-serif;}
.footer-cols{display:flex;flex-wrap:wrap;gap:40px 72px;}
.footer-col{min-width:160px;}
.footer-col-title{font-size:17px;font-weight:600;letter-spacing:.12em;text-transform:uppercase;margin-bottom:16px;}
.footer-col a,.footer-col .footer-soon{display:block;font-size:17px;line-height:2;letter-spacing:.01em;text-decoration:none;}
.footer-col a{transition:color .2s;}
.footer-col .footer-soon{cursor:default;}
.footer-rule{height:1px;border:none;margin:36px 0 18px;}
.footer-copyright{font-size:17px;letter-spacing:.02em;}
.footer-col-title{color:#8a8078;}
.footer-col a,.footer-col .footer-soon{color:#5a4f47;}
.footer-col a:hover{color:#2a2320;}
.footer-rule{background:rgba(0,0,0,.1);}
.footer-copyright{color:#9a9088;}
body.dark-mode .site-footer{background:rgba(0,0,0,.25);}
body.dark-mode .footer-col-title{color:rgba(232,224,214,.5);}
body.dark-mode .footer-col a,body.dark-mode .footer-col .footer-soon{color:rgba(232,224,214,.72);}
body.dark-mode .footer-col a:hover{color:rgba(232,224,214,.95);}
body.dark-mode .footer-copyright{color:rgba(232,224,214,.42);}
body.dark-mode .footer-rule{background:rgba(232,224,214,.12);}

/* not-yet-live nav/menu links: inert, non-clickable, visually uniform */
.nav-links a:not([href]), .menu-panel a:not([href]) { pointer-events: none; cursor: default; }
</style>
</head>
<body>

<!-- ═══ STÄDEL NAV ═══ -->
<nav class="site-nav" aria-label="Site navigation">
  <div class="nav-inner">
    <a href="/" class="wordmark">oyparaploo</a>
    <ul class="nav-links">
      <li><a href="/writing/">Writing</a></li>
      <li><a href="/portraits/">Portraits</a></li>
      <li><a href="/our-practice/" class="active">Practice</a></li>
      <li><a href="/dispatches/">Dispatches</a></li>
    </ul>
    <div class="nav-utils">
      <button id="fontSizeBtn" class="font-size-btn" aria-label="Adjust font size">
        <span class="sz active" data-size="1">A</span><span class="sz" data-size="2">A</span><span class="sz" data-size="3">A</span>
      </button>
      <button id="contrastBtn" aria-label="Toggle contrast">
        <svg class="nav-icon" viewBox="0 0 24 24" aria-hidden="true">
          <circle cx="12" cy="12" r="7"/><path d="M12 5 A7 7 0 0 0 12 19 Z" fill="currentColor" stroke="none"/>
        </svg>
      </button>
      <a href="#" aria-label="Search">
        <svg class="nav-icon" viewBox="0 0 24 24" aria-hidden="true">
          <circle cx="10" cy="10" r="7"/><path d="M15 15l5 5"/>
        </svg>
      </a>
      <button class="nav-hamburger" aria-label="Open menu" aria-expanded="false" id="navHamburger">
        <svg class="nav-icon" viewBox="0 0 24 24" aria-hidden="true">
          <line x1="3" y1="5" x2="21" y2="5"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="19" x2="21" y2="19"/>
        </svg>
      </button>
    </div>
  </div>
  <div class="nav-accent-rule" aria-hidden="true"></div>
</nav>

<!-- ═══ MENU ═══ -->
<div class="menu-overlay" id="menuOverlay" aria-hidden="true"></div>

<div class="menu-panel" id="menuPanel" aria-hidden="true" role="dialog" aria-label="Site menu">
  <div class="menu-top">
    <span class="menu-ghost-wordmark" aria-hidden="true">oyparaploo</span>
    <button class="menu-close" id="menuCloseBtn" aria-label="Close menu">&#10005;</button>
  </div>
  <div class="menu-content">
    <nav class="menu-nav-primary" aria-label="Primary menu">
      <a href="/writing/">Writing</a>
      <a href="/making/">Making</a>
      <a href="/good-grounds/">Good Grounds</a>
    </nav>
    <hr class="menu-rule-tan" aria-hidden="true">
    <nav class="menu-nav-secondary" aria-label="Secondary menu">
      <a href="/our-practice/">Our Practice</a>
      <a aria-disabled="true">Music Artists</a>
      <a aria-disabled="true">Collaborators</a>
      <a href="/methodology/">Methodology</a>
    </nav>
    <hr class="menu-rule-sage" aria-hidden="true">
    <nav class="menu-nav-tertiary" aria-label="Tertiary menu">
      <a href="/support/">Support</a>
      <a href="/archive/">Archive</a>
      <a aria-disabled="true">Calendar</a>
      <a href="mailto:info@oyparaploo.com">Contact</a>
    </nav>
    <div class="menu-address">Minneapolis ~ Saint Paul</div>
    <div class="menu-bottom-btns">
      <button class="menu-btn">Subscribe</button>
    </div>
  </div>
</div>

<div class="sidebar-label">Practice</div>

<main class="three-col">

  <div class="col-left">
    <div class="cl-section">
      <div class="cl-pills">
        <a href="#" class="cl-pill">Archive</a>
        <a href="#" class="cl-pill">Contact</a>
        <a href="#" class="cl-pill">Subscribe</a>
      </div>
    </div>
    <div class="cl-section">
      <div class="cl-title">Location</div>
      <div class="cl-text">Minneapolis ~ Saint Paul<br>Twin Cities, Minnesota</div>
    </div>
    <div class="cl-section">
      <div class="cl-title">Practice Identity</div>
      <div class="cl-text">Wonderful Garbage / Noir Chanson<br>Multi-domain creative practice<br>Writing · Sound · Visual · Performance</div>
    </div>
    <div class="cl-section">
      <div class="cl-title">Collaborator</div>
      <div class="cl-text">Clod Hopper<br>AI creative practice collaborator</div>
    </div>
    <div class="cl-section">
      <div class="cl-title">Site</div>
      <div class="cl-text"><a href="/">oyparaploo.com</a><br>330 pages · 18 grounds · 60 entrances</div>
    </div>
    <div class="colophon">
      <div class="colophon-title">Colophon</div>
      <div class="colophon-text">Design: The Practice<br>Build: Astro + Cloudflare<br>Fonts: Inter, Lora<br>Photography: The Practice</div>
    </div>
  </div>

  <div class="col-center">
    <h1 class="cc-title">Awards &amp; Grants &amp; Milestones</h1>
    <WindowFrame />
    <div class="cv-table">
      <div class="cv-row"><div class="cv-year">2026</div><div class="cv-desc">Oyparaploo site assembly — 351 HTML files, 18 grounds, full Städel nav wired</div></div>
      <div class="cv-row"><div class="cv-year">2026</div><div class="cv-desc">West Has Blessed Voices — first real-time composed piece using Wonderful Garbage methodology</div></div>
      <div class="cv-row"><div class="cv-year">2026</div><div class="cv-desc">The Grounds — eighteen grounds, sixty entrances architectural framework completed</div></div>
      <div class="cv-row"><div class="cv-year">2025</div><div class="cv-desc">Design research phase — 180+ archived HTML files, 8 months of exploration</div></div>
      <div class="cv-row"><div class="cv-year">2025</div><div class="cv-desc">Good Grounds novel project — Salt Flat Quarry Cave</div></div>
