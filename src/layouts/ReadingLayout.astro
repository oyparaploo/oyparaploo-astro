---
import Footer from '../components/Footer.astro';
// ReadingLayout — light-native shell lifted VERBATIM from interview-template
// (canonical a-word-is-a-room Städel nav; ◐ toggles dark). For 'reading' variant essays.
const { title = 'Untitled', date = '', ground = 'light' } = Astro.props;
---
<!DOCTYPE html>
<html lang="en" class="size-1">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<link rel="manifest" href="/manifest.webmanifest">
<meta name="theme-color" content="#000000">
<link rel="apple-touch-icon" href="/icons/icon-192.png">
<script src="/sw-register.js" defer></script>
<title>{title} — Paraploo, The Elder</title>
<link href="https://fonts.googleapis.com/css2?family=Lora:wght@400;500;600;700&family=Inter:wght@300;400;450;500;600;700&display=swap" rel="stylesheet">
<style is:global>

/* ═══════════════════════════════════════════════════════════
   INTERVIEW / Q&A READING TEMPLATE · Light Ground
   A deliberate reading-template exception (approved): not breath-display.
   Chrome grafted verbatim from a-word-is-a-room (light-native canonical).
   Toggle: dark-mode (◐ → ◑).  Strips: none (reading page, per spec).
   ═══════════════════════════════════════════════════════════ */

/* ═══ I. RESET & BASE ═══ */
*, *::before, *::after { margin: 0; padding: 0; box-sizing: border-box; }
p, h1, h2, h3, h4, li, blockquote { text-wrap: pretty; }
em, i, cite, address, dfn, var { font-style: normal; }
* { font-style: normal; }
a { color: inherit; text-decoration: none; }
a, button, [role="button"], select { touch-action: manipulation; -webkit-tap-highlight-color: transparent; }
button { font-family: inherit; border: none; background: none; cursor: pointer; }
ul, ol { list-style: none; }
img { max-width: 100%; height: auto; display: block; }
html { overflow-x: clip; scroll-behavior: smooth; font-size: var(--root-size, 18px); -webkit-text-size-adjust: 100%; text-size-adjust: 100%; }
body.ground-light {
  font-family: 'Inter', sans-serif; -webkit-font-smoothing: antialiased;
  overflow-x: hidden; overflow-wrap: break-word; word-break: break-word;
  transition: background 0.4s ease, color 0.3s ease;
  background-color: #ffffff;
  background-image: linear-gradient(to bottom, #ffffff 0px, #ffffff 320px, #fdfcfb 760px, #f9f7f4 100%);
  background-attachment: scroll;
  color: #2a2320; min-height: 100vh;
}

/* ═══ II. DESIGN TOKENS ═══ */
:root { --oy-sand: #D4C4A8; --oy-tan: #D4A574; --oy-radius: 4px; }

/* ═══ III. FONT SIZE SYSTEM ═══ */
html.size-1 { --root-size: 18px; } html.size-2 { --root-size: 19px; } html.size-3 { --root-size: 21px; }
.font-size-btn { display: flex; gap: 2px; font-weight: 600; align-items: baseline; }
.font-size-btn .sz { color: #000 !important; opacity: 1; transition: opacity 0.25s, color 0.2s; line-height: 1; }
.font-size-btn .sz.active { opacity: 1; }
.font-size-btn .sz[data-size="1"] { font-size: 20px; }
.font-size-btn .sz[data-size="2"] { font-size: 17px; }
.font-size-btn .sz[data-size="3"] { font-size: 14px; }

/* ═══ IV. STÄDEL NAV — LIGHT GROUND (grafted from a-word-is-a-room) ═══ */
.site-nav { position: sticky; top: 0; z-index: 100; background: rgba(255,255,255,0.97); -webkit-backdrop-filter: blur(12px); backdrop-filter: blur(12px); transition: background 0.3s; }
.nav-inner { max-width: 1400px; margin: 0 auto; padding: 0 40px; height: 64px; display: flex; align-items: center; }
.wordmark { font-family: 'Inter', sans-serif; font-weight: 500; font-size: 22px; color: #333; letter-spacing: 0.02em; flex-shrink: 0; transition: color 0.2s; }
.wordmark:hover { color: #5c3a1e; }
.nav-links { display: flex; align-items: center; gap: 32px; list-style: none; padding-left: 0; margin-left: 48px; flex-shrink: 0; }
.nav-links a { font-family: 'Inter', sans-serif; font-size: 20px; font-weight: 500; letter-spacing: 0.02em; color: #333; transition: color 0.2s; white-space: nowrap; }
.nav-links a:hover { color: #5c3a1e; }
.nav-utils { display: flex; align-items: center; gap: 12px; margin-left: auto; }
.nav-utils button, .nav-utils a { font-family: 'Inter', sans-serif; color: #000; background: none; border: none; cursor: pointer; min-height: 44px; padding: 0 8px; display: flex; align-items: center; justify-content: center; transition: color 0.2s; }
.nav-utils button:hover, .nav-utils a:hover { color: #5c3a1e; }
.font-size-btn:hover .sz { color: #5c3a1e !important; }
.nav-utils svg { stroke: currentColor; fill: none; stroke-width: 2; }
.nav-icon { width: 22px; height: 22px; display: block; }
.nav-hamburger { display: flex; flex-direction: column; justify-content: center; align-items: center; gap: 5px; min-height: 44px; padding: 0 8px; }
.nav-hamburger line { stroke: #333; stroke-width: 2.5; transition: transform 0.25s, opacity 0.2s; transform-box: fill-box; transform-origin: center; }
.nav-hamburger.open line:nth-child(1) { transform: translateY(7px) rotate(45deg); }
.nav-hamburger.open line:nth-child(2) { opacity: 0; }
.nav-hamburger.open line:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }
.nav-accent-rule { display: block; height: 2px; border: none; background: linear-gradient(90deg, transparent 0%, rgba(122,90,74,0.35) 8%, rgba(122,90,74,0.55) 15%, rgba(122,90,74,0.28) 24%, rgba(92,58,30,0.45) 34%, rgba(92,58,30,0.65) 44%, rgba(92,58,30,0.28) 54%, rgba(122,90,74,0.50) 63%, rgba(160,128,100,0.40) 74%, rgba(160,128,100,0.28) 83%, rgba(122,90,74,0.30) 90%, transparent 100%); }

/* ═══ V. MENU SYSTEM (grafted) ═══ */
.menu-overlay { position: fixed; inset: 0; z-index: 200; background: rgba(0,0,0,0.45); opacity: 0; pointer-events: none; transition: opacity 0.6s; }
.menu-overlay.open { opacity: 1; pointer-events: auto; }
.menu-strips { display: none !important; }
.menu-panel { position: fixed; top: 0; right: 0; bottom: 0; z-index: 201; width: 400px; max-width: 90vw; background: #faf6f0; color: #2a2320; font-size: 17px; clip-path: inset(16px 20px calc(100% - 68px) calc(100% - 200px) round var(--oy-radius)); transition: clip-path 0.6s cubic-bezier(0.4, 0, 0.1, 1), opacity 0.2s ease; overflow-y: auto; padding: 24px 32px 40px; pointer-events: none; opacity: 0; }
.menu-panel.open { clip-path: inset(0 0 0 0 round 0); pointer-events: auto; opacity: 1; }
.menu-top { display: flex; align-items: center; justify-content: space-between; margin-bottom: 32px; }
.menu-ghost-wordmark { font-family: 'Inter', sans-serif; font-size: 22px; font-weight: 500; color: #2a2320; opacity: 0.38; letter-spacing: 0.02em; user-select: none; pointer-events: none; }
.menu-close { width: 44px; height: 44px; display: flex; align-items: center; justify-content: center; font-size: 22px; color: #2a2320 !important; cursor: pointer; transition: opacity 0.2s; flex-shrink: 0; }
.menu-close:hover { opacity: 0.62; }
.menu-nav-primary { margin-bottom: 4px; }
.menu-nav-primary a { font-family: 'Lora', serif; font-size: 24px; font-weight: 600; color: #2a2320; display: block; padding: 10px 0; line-height: 1.2; transition: opacity 0.2s; }
.menu-nav-primary a:hover { opacity: 0.55; }
.menu-rule-tan { height: 2px; border: none; background: var(--oy-tan); margin: 20px 0; }
.menu-rule-sage { height: 2px; border: none; background: #8BA89A; margin: 20px 0; }
.menu-nav-secondary { margin-bottom: 4px; }
.menu-nav-secondary a { font-family: 'Inter', sans-serif; font-size: 18px; font-weight: 600; color: #2a2320; display: block; padding: 4px 0; transition: opacity 0.2s; }
.menu-nav-secondary a:hover { opacity: 0.55; }
.menu-nav-tertiary { display: block; margin-bottom: 4px; }
.menu-nav-tertiary a { font-family: 'Inter', sans-serif; font-size: 18px; font-weight: 600; color: #2a2320; display: block; padding: 4px 0; transition: opacity 0.2s; }
.menu-nav-tertiary a:hover { opacity: 0.55; }
.menu-address { font-family: 'Inter', sans-serif; font-size: 19px; font-weight: 500; color: #5a4f47; margin-top: 20px; line-height: 1.6; }
.menu-bottom-btns { display: flex; gap: 8px; margin-top: 20px; }
.menu-bottom-btns .menu-btn { font-family: 'Inter', sans-serif; font-size: 16px; font-weight: 500; letter-spacing: 0.06em; text-transform: uppercase; color: #2a2320; border: 1px solid #b3aba6; padding: 8px 16px; border-radius: var(--oy-radius); background: transparent; cursor: pointer; transition: background 0.2s, color 0.2s, border-color 0.2s; min-height: 44px; }
.menu-bottom-btns .menu-btn:hover { background: #2a2320; color: #faf8f5; border-color: #2a2320; }
.mobile-strips { display: none !important; }

/* ═══ VI. SCROLL REVEAL (opacity only) ═══ */
.reveal { opacity: 0; transition: opacity 1.2s ease; }
.reveal-slow { opacity: 0; transition: opacity 2.5s ease; }
.reveal.visible, .reveal-slow.visible { opacity: 1; }

/* ═══ VII. PAGE — INTERVIEW / Q&A ═══ */
.iv-wrap { max-width: 1200px; margin: 0 auto; padding: 0 40px; }

/* — Hero — */
.iv-hero { padding: 76px 0 8px; }
.iv-eyebrow { font-family: 'Inter', sans-serif; font-size: 1rem; font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase; color: #5a4f47; margin-bottom: 22px; }
.iv-title { font-family: 'Lora', serif; font-size: clamp(2.1176rem, 4.6vw, 3.1765rem); font-weight: 600; color: #2a2320; line-height: 1.12; letter-spacing: -0.02em; max-width: 20ch; margin-bottom: 22px; }
.iv-names { font-family: 'Inter', sans-serif; font-size: 1.0588rem; font-weight: 500; color: #4a4038; letter-spacing: 0; }
.iv-names .sep { color: #b8a088; padding: 0 10px; }

/* — Hero collage: three bracketed placeholder frames — */
.iv-collage { display: grid; grid-template-columns: repeat(3, 1fr); gap: 22px; margin-top: 44px; padding: 18px; position: relative; }
.iv-collage::before, .iv-collage::after { content: ''; position: absolute; width: 30px; height: 30px; border: 2px solid #D4A574; }
.iv-collage::before { top: 0; left: 0; border-right: none; border-bottom: none; }
.iv-collage::after { bottom: 0; right: 0; border-left: none; border-top: none; }
.iv-frame { background: #e8e4de; border: 1px solid #b8a088; border-radius: var(--oy-radius); aspect-ratio: 4 / 5; }
.iv-frame.alt { background: #e0dcd6; }
.iv-frame.mid { margin-top: 34px; }
.iv-frame-cap { font-family: 'Inter', sans-serif; font-size: 1rem; font-weight: 500; color: #5a4f47; letter-spacing: 0.04em; text-align: center; margin-top: 10px; }

/* — Dark deck band (standfirst) — full-bleed dark within light page — */
.iv-deck { background: #1a1614; margin: 64px 0; padding: 66px 0; }
.iv-deck-inner { max-width: 760px; margin: 0 auto; padding: 0 40px; }
.iv-deck p { font-family: 'Inter', sans-serif; font-size: clamp(1.1765rem, 2vw, 1.4118rem); font-weight: 400; color: #d0c8bf; line-height: 1.7; }
.iv-deck p + p { margin-top: 1em; }

/* — Conversation: alternating Q&A, 55/45 — */
.iv-convo { padding: 8px 0 16px; }
.iv-note { font-family: 'Inter', sans-serif; font-size: 1rem; font-weight: 600; letter-spacing: 0.06em; text-transform: uppercase; color: #5a4f47; border: 1px solid #c0b8b0; border-radius: var(--oy-radius); display: inline-block; padding: 7px 14px; margin: 8px 0 8px; }
.iv-qa { display: grid; grid-template-columns: 55fr 45fr; gap: 52px; align-items: start; margin: 60px 0; }
.iv-qa.flip .iv-qa-text { order: 2; }
.iv-qa.flip .iv-qa-portrait { order: 1; }
.iv-portrait { padding: 14px; position: relative; position: sticky; top: 96px; }
.iv-portrait::before, .iv-portrait::after { content: ''; position: absolute; width: 22px; height: 22px; border: 2px solid #D4A574; }
.iv-portrait::before { top: 0; left: 0; border-right: none; border-bottom: none; }
.iv-portrait::after { bottom: 0; right: 0; border-left: none; border-top: none; }
.iv-portrait-frame { background: #e8e4de; border: 1px solid #b8a088; border-radius: var(--oy-radius); aspect-ratio: 3 / 4; }
.iv-q { margin-bottom: 16px; }
.iv-label { font-family: 'Inter', sans-serif; font-size: 1rem; font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase; color: #5a4f47; display: block; margin-bottom: 9px; }
.iv-q-text { font-family: 'Inter', sans-serif; font-size: clamp(1.1176rem, 1.9vw, 1.2941rem); font-weight: 600; color: #2a2320; line-height: 1.45; letter-spacing: -0.01em; }
.iv-a { margin-top: 22px; }
.iv-a-text { font-family: 'Inter', sans-serif; font-size: 1rem; font-weight: 400; color: #2a2320; line-height: 1.72; letter-spacing: -0.01em; }
.iv-a-text + .iv-a-text { margin-top: 1em; }

/* — Pull quote — Lora display, large, solid hex — */
.iv-pull { max-width: 860px; margin: 84px auto; }
.iv-pull blockquote { font-family: 'Lora', serif; font-size: clamp(1.7647rem, 3.6vw, 2.5294rem); font-weight: 600; color: #2a2320; line-height: 1.26; letter-spacing: -0.02em; }
.iv-pull blockquote .mk { color: #D4A574; }
.iv-pull cite { display: block; margin-top: 18px; font-family: 'Inter', sans-serif; font-size: 1rem; font-weight: 500; color: #5a4f47; letter-spacing: 0.04em; text-transform: uppercase; }

/* — Related row — */
.iv-related { border-top: 1px solid #c0b8b0; margin-top: 80px; padding: 48px 0 8px; }
.iv-related-h { font-family: 'Inter', sans-serif; font-size: 1rem; font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase; color: #5a4f47; margin-bottom: 28px; }
.iv-related-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; }
.iv-card { display: block; border: 1px solid #b8a088; border-radius: var(--oy-radius); padding: 24px 24px 22px; transition: border-color 0.3s ease, background 0.3s ease; }
.iv-card:hover { border-color: #8a6e50; background: #faf7f3; }
.iv-card-reg { font-family: 'Inter', sans-serif; font-size: 1rem; font-weight: 500; letter-spacing: 0.05em; text-transform: uppercase; color: #5a4f47; margin-bottom: 11px; }
.iv-card-title { font-family: 'Lora', serif; font-size: 1.2353rem; font-weight: 600; color: #2a2320; line-height: 1.3; letter-spacing: -0.01em; }
.iv-card:hover .iv-card-title { color: #000; }

.bottom-safe { padding-bottom: env(safe-area-inset-bottom, 0px); }

/* ═══ VIII. RESPONSIVE ═══ */
@media (max-width: 1100px) { .nav-links { display: none; } }
@media (max-width: 1024px) {
  .iv-qa, .iv-qa.flip { grid-template-columns: 1fr; gap: 28px; }
  .iv-qa.flip .iv-qa-text, .iv-qa.flip .iv-qa-portrait { order: 0; }
  .iv-portrait { position: static; top: auto; max-width: 360px; }
  .iv-related-grid { grid-template-columns: 1fr 1fr; }
}
@media (max-width: 768px) {
  .nav-inner { padding: 0 24px; }
  .menu-panel { width: 100%; max-width: 100%; }
  .iv-wrap { padding: 0 24px; }
  .iv-deck-inner { padding: 0 24px; }
  .iv-collage { grid-template-columns: 1fr 1fr; }
  .iv-frame.mid { margin-top: 0; }
  .iv-related-grid { grid-template-columns: 1fr; }
  .reveal { transition: opacity 0.6s ease; }
  .reveal-slow { transition: opacity 1s ease; }
}
@media (max-width: 480px) {
  .nav-inner { padding: 0 24px; }
  .nav-utils { margin-left: auto; gap: 10px; }
  .nav-utils button, .nav-utils a, .nav-hamburger { padding: 0; }
  .iv-collage { grid-template-columns: 1fr; }
  .iv-hero { padding: 60px 0 8px; }
}

/* ═══ IX. DARK MODE (chrome grafted + page content overrides) ═══ */
body.ground-light.dark-mode {
  background: linear-gradient(to bottom, #000000 0%, #000000 5%, #020203 12%, #040507 20%, #060810 30%, #080a13 40%, #0a0d16 50%, #0b0f18 60%, #0d111b 70%, #0e121d 80%, #10141f 90%, #111521 100%);
  background-attachment: fixed; min-height: 100vh; color: #d0c8bf;
}
body.dark-mode .site-nav { background: rgba(0,0,0,0.92); -webkit-backdrop-filter: blur(12px); backdrop-filter: blur(12px); }
body.dark-mode .wordmark { color: rgba(232,224,214,0.68); }
body.dark-mode .wordmark:hover { color: rgba(232,224,214,0.88); }
body.dark-mode .nav-links a { color: rgba(232,224,214,0.68); }
body.dark-mode .nav-links a:hover { color: rgba(232,224,214,0.88); }
body.dark-mode .nav-utils button, body.dark-mode .nav-utils a { color: rgba(232,224,214,0.68); }
body.dark-mode .nav-utils button:hover, body.dark-mode .nav-utils a:hover { color: rgba(232,224,214,0.88); }
body.dark-mode .nav-hamburger line { stroke: rgba(232,224,214,0.68); }
body.dark-mode #contrastBtn svg { transform: scaleX(-1); }
body.dark-mode .font-size-btn .sz { color: rgba(232,224,214,0.68) !important; }
body.dark-mode .font-size-btn:hover .sz { color: rgba(232,224,214,0.88) !important; }
body.dark-mode .nav-accent-rule { opacity: 0.6; }
/* content */
body.dark-mode .iv-eyebrow { color: #a09888; }
body.dark-mode .iv-title { color: #d0c8bf; }
body.dark-mode .iv-names { color: #b5ada5; }
body.dark-mode .iv-names .sep { color: #3a3430; }
body.dark-mode .iv-frame { background: #0d111b; border-color: #3a3430; }
body.dark-mode .iv-frame.alt { background: #0e121d; }
body.dark-mode .iv-frame-cap { color: #a09888; }
body.dark-mode .iv-deck { background: #141210; border-top: 1px solid #3a3430; border-bottom: 1px solid #3a3430; }
body.dark-mode .iv-deck p { color: #d0c8bf; }
body.dark-mode .iv-note { color: #a09888; border-color: #3a3430; }
body.dark-mode .iv-label { color: #a09888; }
body.dark-mode .iv-q-text { color: #d0c8bf; }
body.dark-mode .iv-a-text { color: #d0c8bf; }
body.dark-mode .iv-portrait-frame { background: #0d111b; border-color: #3a3430; }
body.dark-mode .iv-pull blockquote { color: #d0c8bf; }
body.dark-mode .iv-pull cite { color: #a09888; }
body.dark-mode .iv-related { border-top-color: #3a3430; }
body.dark-mode .iv-related-h { color: #a09888; }
body.dark-mode .iv-card { border-color: #3a3430; }
body.dark-mode .iv-card:hover { border-color: #5a5048; background: #141210; }
body.dark-mode .iv-card-reg { color: #a09888; }
body.dark-mode .iv-card-title { color: #ccc5bc; }
body.dark-mode .iv-card:hover .iv-card-title { color: #e8e0d8; }


/* not-yet-live nav/menu links: inert, non-clickable, visually uniform */
.nav-links a:not([href]), .menu-panel a:not([href]) { pointer-events: none; cursor: default; }

/* ═══ XI. READING ARTICLE (authored — Lora headings, Inter body, solid hex, no italic) ═══ */
.reading-wrap { max-width: 760px; margin: 0 auto; padding: 0 40px; }
.reading-article { padding: 76px 0 8px; }
.reading-title { font-family: 'Lora', serif; font-size: clamp(1.6667rem, calc(2.2222rem - max(0rem, calc((var(--title-chars, 22) - 22) * 0.0306rem))), 2.2222rem); font-weight: 600; color: #2a2320; line-height: 1.14; letter-spacing: -0.02em; max-width: 24ch; margin-bottom: 40px; }
.reading-body p { font-family: 'Inter', sans-serif; font-size: 1.0588rem; font-weight: 400; color: #2a2320; line-height: 1.75; letter-spacing: -0.01em; margin-bottom: 1.05em; }
.reading-body h2 { font-family: 'Lora', serif; font-size: clamp(1.5294rem, 2.6vw, 1.9412rem); font-weight: 600; color: #2a2320; line-height: 1.22; letter-spacing: -0.01em; margin: 1.9em 0 0.55em; }
.reading-body h3 { font-family: 'Lora', serif; font-size: clamp(1.2941rem, 2vw, 1.5294rem); font-weight: 600; color: #3a3028; line-height: 1.28; margin: 1.55em 0 0.5em; }
.reading-body strong { font-weight: 600; color: #2a2320; }
.reading-body ul, .reading-body ol { font-family: 'Inter', sans-serif; font-size: 1.0588rem; color: #2a2320; line-height: 1.7; margin: 0 0 1.05em 1.4em; }
.reading-body ul { list-style: disc; } .reading-body ol { list-style: decimal; }
.reading-body li { margin-bottom: 0.4em; } .reading-body li::marker { color: #b8a088; }
.reading-body blockquote { font-family: 'Lora', serif; font-size: clamp(1.4118rem, 2.4vw, 1.7647rem); font-weight: 600; color: #2a2320; line-height: 1.3; letter-spacing: -0.01em; margin: 1.4em 0; padding-left: 0.85em; border-left: 2px solid #D4A574; }
.reading-body .ellipsis { color: #b8a088; letter-spacing: 0.15em; }
.dash-thin { font-weight: 300; }
.reading-colophon { height: 1px; border: none; background: rgba(0,0,0,0.1); margin: 72px 0 0; }
.reading-colophon-date { margin: 18px 0 32px; font-family: 'Inter', sans-serif; font-size: 17px; letter-spacing: 0.04em; color: #5a4f47; }
body.dark-mode .reading-colophon-date { color: #a09888; }
@media (max-width: 768px) { .reading-wrap { padding: 0 24px; } .reading-article { padding: 60px 0 8px; } }
/* reading content — dark mode (◐ toggles dark) */
body.dark-mode .reading-title { color: #d0c8bf; }
body.dark-mode .reading-body p { color: #d0c8bf; }
body.dark-mode .reading-body h2 { color: #d0c8bf; }
body.dark-mode .reading-body h3 { color: #ccc5bc; }
body.dark-mode .reading-body strong { color: #e8e0d8; }
body.dark-mode .reading-body ul, body.dark-mode .reading-body ol, body.dark-mode .reading-body li { color: #d0c8bf; }
body.dark-mode .reading-body li::marker { color: #8a8078; }
body.dark-mode .reading-body blockquote { color: #d0c8bf; border-left-color: #D4A574; }
body.dark-mode .reading-body .ellipsis { color: #a09888; }
body.dark-mode .reading-colophon { background: rgba(232,224,214,0.12); }
/* ═══ SEARCH OVERLAY (lazy MiniSearch) — nav infrastructure ═══ */
.oy-search { position: fixed; inset: 0; z-index: 300; display: flex; justify-content: center; padding: 96px 24px 32px; overflow-y: auto; opacity: 0; pointer-events: none; transition: opacity 0.4s ease; -webkit-backdrop-filter: blur(14px); backdrop-filter: blur(14px); }
.oy-search.open { opacity: 1; pointer-events: auto; }
.oy-search-inner { width: 100%; max-width: 680px; }
.oy-search-close { position: absolute; top: 24px; right: 24px; width: 44px; height: 44px; display: flex; align-items: center; justify-content: center; font-family: 'Inter', sans-serif; font-size: 24px; line-height: 1; background: none; border: none; cursor: pointer; }
.oy-search-input { width: 100%; background: none; border: none; border-bottom: 1px solid; font-family: 'Lora', serif; font-size: clamp(1.7059rem, 3.2vw, 2.0588rem); font-weight: 400; letter-spacing: -0.01em; padding: 0 0 16px; margin-bottom: 24px; outline: none; }
.oy-search-status { font-family: 'Inter', sans-serif; font-size: 1rem; font-weight: 400; letter-spacing: 0.02em; margin-bottom: 20px; }
.oy-search-results { list-style: none; margin: 0; padding: 0; }
.oy-search-item { border-top: 1px solid; }
.oy-search-link { display: block; padding: 18px 0; text-decoration: none; transition: background 0.2s ease; }
.oy-search-title { display: block; font-family: 'Lora', serif; font-size: 1.2353rem; font-weight: 600; line-height: 1.3; letter-spacing: -0.01em; margin-bottom: 6px; transition: color 0.2s ease; }
.oy-search-meta { display: block; font-family: 'Inter', sans-serif; font-size: 1rem; font-weight: 500; letter-spacing: 0.04em; margin-bottom: 8px; }
.oy-search-excerpt { display: block; font-family: 'Inter', sans-serif; font-size: 1rem; font-weight: 400; line-height: 1.6; text-wrap: pretty; }
@media (max-width: 480px) { .oy-search { padding: 80px 24px 24px; } .oy-search-close { top: 16px; right: 16px; } }
/* light theme (light-native, or dark-native toggled to light) */
body.ground-light .oy-search, body.ground-dark.light-mode .oy-search { background: rgba(255,255,255,0.97); }
body.ground-light .oy-search-close, body.ground-dark.light-mode .oy-search-close { color: #2a2320; }
body.ground-light .oy-search-input, body.ground-dark.light-mode .oy-search-input { color: #2a2320; border-bottom-color: #b8a088; }
body.ground-light .oy-search-input::placeholder, body.ground-dark.light-mode .oy-search-input::placeholder { color: #5a4f47; }
body.ground-light .oy-search-status, body.ground-dark.light-mode .oy-search-status { color: #5a4f47; }
body.ground-light .oy-search-item, body.ground-dark.light-mode .oy-search-item { border-top-color: #c0b8b0; }
body.ground-light .oy-search-link:hover, body.ground-dark.light-mode .oy-search-link:hover { background: #faf7f3; }
body.ground-light .oy-search-title, body.ground-dark.light-mode .oy-search-title { color: #2a2320; }
body.ground-light .oy-search-link:hover .oy-search-title, body.ground-dark.light-mode .oy-search-link:hover .oy-search-title { color: #000000; }
body.ground-light .oy-search-meta, body.ground-dark.light-mode .oy-search-meta { color: #5a4f47; }
body.ground-light .oy-search-excerpt, body.ground-dark.light-mode .oy-search-excerpt { color: #4a4038; }
/* dark theme (dark-native, or light-native toggled to dark) */
body.ground-dark .oy-search, body.ground-light.dark-mode .oy-search { background: rgba(8,9,13,0.95); }
body.ground-dark .oy-search-close, body.ground-light.dark-mode .oy-search-close { color: #d0c8bf; }
body.ground-dark .oy-search-input, body.ground-light.dark-mode .oy-search-input { color: #d0c8bf; border-bottom-color: #5a5048; }
body.ground-dark .oy-search-input::placeholder, body.ground-light.dark-mode .oy-search-input::placeholder { color: #a09888; }
body.ground-dark .oy-search-status, body.ground-light.dark-mode .oy-search-status { color: #a09888; }
body.ground-dark .oy-search-item, body.ground-light.dark-mode .oy-search-item { border-top-color: #3a3430; }
body.ground-dark .oy-search-link:hover, body.ground-light.dark-mode .oy-search-link:hover { background: #141210; }
body.ground-dark .oy-search-title, body.ground-light.dark-mode .oy-search-title { color: #d0c8bf; }
body.ground-dark .oy-search-link:hover .oy-search-title, body.ground-light.dark-mode .oy-search-link:hover .oy-search-title { color: #e8e0d8; }
body.ground-dark .oy-search-meta, body.ground-light.dark-mode .oy-search-meta { color: #a09888; }
body.ground-dark .oy-search-excerpt, body.ground-light.dark-mode .oy-search-excerpt { color: #b5ada5; }
</style>
</head>
